                    else
                    {
                        <button type="button" class="btn text-dark fw-bold px-4 py-2" style="background: #00ff87; border-radius: 8px; box-shadow: 0 4px 15px rgba(0,255,135,0.3);" @onclick="ConfirmPayment">Xác nhận thanh toán</button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Order> orders;
    private string searchQuery = "";

    // Thêm biến cho Payment Modal
    private bool showPaymentModal = false;
    private int selectedPaymentOrderId = 0;
    private string selectedPaymentMethod = "PayOS";

    private void OpenPaymentModal(int orderId)
    {
        selectedPaymentOrderId = orderId;
        selectedPaymentMethod = "PayOS";
        showPaymentModal = true;
    }

    private void ClosePaymentModal()
    {
        showPaymentModal = false;
        selectedPaymentOrderId = 0;
    }

    private void ConfirmPayment()
    {
        if (selectedPaymentOrderId > 0)
        {
            // Điều hướng sang BookingController
            NavManager.NavigateTo($"/Booking/PayExistingOrder?orderId={selectedPaymentOrderId}&paymentMethod={selectedPaymentMethod}", forceLoad: true);
        }
    }

    private IEnumerable<Order> FilteredOrders => string.IsNullOrWhiteSpace(searchQuery)
        ? orders
        : orders.Where(o => o.OrderDetails.Any(d =>
            d.Showtime?.Movie?.Title?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) == true));

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? "";
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity.IsAuthenticated)
        {
            orders = await Db.Orders
                .Include(o => o.OrderDetails).ThenInclude(od => od.Showtime).ThenInclude(s => s.Movie)
                .Include(o => o.OrderDetails).ThenInclude(od => od.Showtime).ThenInclude(s => s.CinemaHall).ThenInclude(ch => ch.Cinema)
                .Include(o => o.OrderDetails).ThenInclude(od => od.Seat)
                .Where(o => o.User.UserName == user.Identity.Name)
                .OrderByDescending(o => o.OrderDate)
                .ToListAsync();
        }
    }
}