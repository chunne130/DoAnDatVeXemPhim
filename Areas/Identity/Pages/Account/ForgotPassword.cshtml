@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Khôi phục mật khẩu";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

<style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
        font-family: 'Inter', sans-serif;
        background-color: #010a04;
        background-image: 
            radial-gradient(ellipse at 10% 90%, rgba(0, 255, 135, 0.15) 0%, transparent 50%),
            radial-gradient(ellipse at 90% 10%, rgba(0, 255, 135, 0.15) 0%, transparent 50%),
            linear-gradient(135deg, #010a04 0%, #021a0d 100%);
        background-attachment: fixed;
        min-height: 100vh;
        margin: 0;
        padding: 0;
        position: relative;
        overflow-y: scroll; /* Force scrollbar to prevent layout shift */
    }

    .split-container {
        width: 100%;
        min-height: 100vh;
        display: flex;
        z-index: 1;
    }

    .left-banner {
        width: 50%;
        background: linear-gradient(145deg, #022c22 0%, #061512 60%, #010a04 100%);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 60px 80px;
        color: #ffffff;
        position: relative;
        animation: fadeIn 0.8s ease-out forwards;
    }

    .brand-logo-area img {
        height: 35px;
    }

    .banner-text-heading {
        font-size: 3rem;
        font-weight: 300;
        line-height: 1.2;
        max-width: 480px;
        margin-bottom: 40px;
    }

    .banner-text-heading strong {
        font-weight: 600;
        display: block;
        color: #00ff87;
    }

    .right-form-area {
        width: 50%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 60px;
        background: rgba(15, 25, 20, 0.45);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        border-left: 1px solid rgba(255, 255, 255, 0.08);
    }
    
    .register-form-wrapper {
        width: 100%;
        max-width: 440px;
        animation: fadeLeft 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        opacity: 0;
        transform: translateX(20px);
    }
    
    @@keyframes fadeLeft {
        to { opacity: 1; transform: translateX(0); }
    }
    
    @@keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    .icon-circle {
        width: 64px;
        height: 64px;
        background: rgba(0,255,135,0.1);
        border: 1px solid rgba(0,255,135,0.2);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 20px;
        font-size: 1.8rem;
        color: #00ff87;
        box-shadow: 0 0 20px rgba(0,255,135,0.15);
    }

    .form-title {
        font-size: 2rem;
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 8px;
    }

    .form-subtitle {
        color: #9ca3af;
        font-size: 0.95rem;
        margin-bottom: 30px;
    }

    .custom-label-small {
        font-size: 0.85rem;
        font-weight: 600;
        color: #d1d5db;
        margin-bottom: 8px;
        display: block;
        letter-spacing: 0.3px;
    }

    .input-wrapper-figma {
        position: relative;
        margin-bottom: 24px;
    }

    .input-wrapper-figma input {
        width: 100%;
        padding: 14px 18px 14px 46px; /* 46px left padding for icon */
        font-size: 1rem;
        color: #ffffff;
        background-color: rgba(0, 0, 0, 0.4);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        transition: all 0.3s ease;
        font-family: 'Inter', sans-serif;
    }

    .input-wrapper-figma input::placeholder {
        color: #6b7280;
    }

    .input-wrapper-figma input:focus {
        outline: none;
        border-color: #00ff87;
        background-color: rgba(0, 255, 135, 0.03);
        box-shadow: 0 0 0 4px rgba(0, 255, 135, 0.15), inset 0 0 0 1px #00ff87;
    }

    .input-icon {
        position: absolute;
        left: 16px;
        top: 50%;
        transform: translateY(-50%);
        color: #6b7280;
        font-size: 1.2rem;
        z-index: 15;
    }

    .btn-create-account-figma {
        width: 100%;
        background: linear-gradient(135deg, #00ff87 0%, #00c060 100%);
        color: #010a04;
        font-weight: 700;
        font-size: 1.05rem;
        padding: 14px;
        border: none;
        border-radius: 12px;
        margin-top: 10px;
        margin-bottom: 24px;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        text-transform: uppercase;
        letter-spacing: 1px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .btn-create-account-figma:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(0, 255, 135, 0.3);
    }

    .btn-create-account-figma:active {
        transform: translateY(0);
    }

    .back-link {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        font-size: 0.95rem;
        color: #9ca3af;
        text-decoration: none;
        transition: all 0.2s;
        font-weight: 500;
    }

    .back-link:hover { 
        color: #00ff87;
        text-shadow: 0 0 10px rgba(0,255,135,0.4);
    }

    @@media (max-width: 992px) {
        body { padding: 20px; }
        .left-banner { display: none; }
        .right-form-area {
            width: 100%;
            padding: 40px 20px;
            background: transparent;
            border-left: none;
        }
        .split-container {
            width: 100%;
            max-width: 460px;
            min-height: auto;
            border-radius: 20px;
            background: rgba(15, 25, 20, 0.65);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-top: 1px solid rgba(255, 255, 255, 0.15);
            box-shadow: 0 30px 60px rgba(0, 0, 0, 0.6), inset 0 0 0 1px rgba(255,255,255,0.02);
            margin: auto;
            overflow: hidden;
        }
    }
</style>
</head>
<body>
<div class="split-container">
    <div class="left-banner">
        <div class="brand-logo-area">
            <h3 class="fw-bold m-0 text-success" style="letter-spacing: 1px;"><i class="bi bi-film"></i> CinemaHub</h3>
        </div>

        <div class="banner-core-message">
            <h1 class="banner-text-heading">
                Welcome.
                <strong>Begin your cinematic adventure now with our ticketing platform!</strong>
            </h1>
        </div>

        <div class="banner-footer-small">
            <p class="small text-white-50 mb-0">© 2026 Cinema Hub Platform. All rights reserved.</p>
        </div>
    </div>

    <div class="right-form-area">
        <div class="register-form-wrapper">
    <div class="icon-circle">
        <i class="bi bi-shield-lock-fill"></i>
    </div>

    <h2 class="form-title">Quên mật khẩu?</h2>
    <p class="form-subtitle">Nhập email đã đăng ký, chúng tôi sẽ gửi link đặt lại mật khẩu cho bạn.</p>

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>

        <div>
            <label asp-for="Input.Email" class="custom-label-small">Địa chỉ Email đăng ký</label>
            <div class="input-wrapper-figma">
                <i class="bi bi-envelope-fill input-icon"></i>
                <input asp-for="Input.Email"
                       autocomplete="username"
                       aria-required="true"
                       placeholder="Nhập email của bạn..." />
            </div>
            <span asp-validation-for="Input.Email" class="text-danger small d-block mt-1 mb-3"></span>
        </div>

        <button type="submit" class="btn-create-account-figma">
            <i class="bi bi-send-fill"></i> Gửi yêu cầu khôi phục
        </button>
    </form>

    <div style="margin-top: 16px;">
        <a asp-page="./Login" class="back-link">
            <i class="bi bi-arrow-left"></i> Quay lại đăng nhập
        </a>
    </div>
        </div>
    </div>
</div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>