@page
@model DeletePersonalDataModel
@{
    ViewData["Title"] = "XÁC NHẬN XÓA TÀI KHOẢN";
}

<div class="card border-0 shadow-sm rounded-0 bg-white">
    @* Header Đen chữ Vàng *@
    <div class="card-header bg-dark py-3 rounded-0 border-bottom border-danger">
        <h6 class="mb-0 fw-bold text-uppercase" style="color: #ffc107; letter-spacing: 1px;">
            <i class="bi bi-person-x-fill me-2 text-danger"></i> @ViewData["Title"]
        </h6>
    </div>

    <div class="card-body p-4 p-md-5">
        @* Alert Cảnh báo màu Đen viền Đỏ *@
        <div class="alert alert-dark rounded-0 border-danger border-start-4 mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-exclamation-octagon-fill text-danger fs-3 me-3"></i>
                <div>
                    <strong class="text-danger d-block text-uppercase">Hành động này không thể hoàn tác!</strong>
                    <span class="text-white-50 small">Việc xóa dữ liệu này sẽ gỡ bỏ vĩnh viễn tài khoản của bạn khỏi hệ thống Cinema Hub.</span>
                </div>
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="col-md-9">
                <form id="delete-user" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>

                    @if (Model.RequirePassword)
                    {
                        <div class="mb-4">
                            <label asp-for="Input.Password" class="form-label small fw-bold text-dark text-uppercase">Nhập mật khẩu để xác nhận *</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-dark rounded-0"><i class="bi bi-key-fill"></i></span>
                                <input asp-for="Input.Password" class="form-control rounded-0 border-dark" autocomplete="current-password" aria-required="true" placeholder="Xác nhận mật khẩu của bạn..." />
                            </div>
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>
                    }

                    <div class="text-center mt-5">
                        <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                            @* Nút Quay lại *@
                            <a asp-page="./PersonalData" class="btn btn-outline-dark rounded-0 px-4 fw-bold text-uppercase">
                                Hủy bỏ
                            </a>
                            @* Nút Xóa vĩnh viễn *@
                            <button class="btn btn-danger rounded-0 px-4 fw-bold text-uppercase shadow-sm" type="submit">
                                Xóa dữ liệu & Đóng tài khoản
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    /* Style đặc trưng Cinema Hub */
    .card {
        border-top: 4px solid #ed1c24 !important; /* Đổi sang vạch đỏ vì đây là trang xóa */
    }

    .alert-dark {
        background-color: #1a1a1a;
        border: none;
    }

    .border-start-4 {
        border-left: 4px solid #ed1c24 !important;
    }

    .form-control:focus {
        border-color: #ed1c24 !important;
        box-shadow: 0 0 0 0.25rem rgba(237, 28, 36, 0.15) !important;
    }

    .btn-danger {
        background-color: #ed1c24;
        border: none;
        transition: 0.3s;
    }

        .btn-danger:hover {
            background-color: #b31217;
            transform: translateY(-2px);
        }

    .btn-outline-dark:hover {
        background-color: #000;
        color: #ffc107;
        border-color: #000;
    }
</style>