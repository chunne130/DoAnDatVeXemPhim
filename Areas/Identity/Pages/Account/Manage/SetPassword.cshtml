@page
@model SetPasswordModel
@{
    ViewData["Title"] = "TẠO MẬT KHẨU LẦN ĐẦU";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="card bg-transparent border-0">
    <div class="card-header bg-transparent border-bottom border-secondary mb-3 pb-2">
        <h6 class="mb-0 fw-bold text-uppercase" style="color: #00ff87; letter-spacing: 1px;">
            <i class="bi bi-shield-lock-fill me-2"></i> TẠO MẬT KHẨU CÁ NHÂN
        </h6>
    </div>

    <div class="card-body p-0">
        <partial name="_StatusMessage" for="StatusMessage" />
        
        <div class="alert mb-4" style="background: rgba(13, 202, 240, 0.1); border-left: 4px solid #0dcaf0; color: #e0e6e4;">
            <i class="bi bi-info-circle-fill me-2" style="color: #0dcaf0;"></i>
            Bạn đang đăng nhập bằng tài khoản liên kết ngoài (Google, Facebook...). Hãy tạo thêm một mật khẩu tĩnh để có thể đăng nhập trực tiếp bằng email mà không cần qua bên thứ ba.
        </div>

        <form id="set-password-form" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>

            <div class="row">
                <div class="col-md-9">

                    @* Mật khẩu mới *@
                    <div class="mb-3">
                        <label asp-for="Input.NewPassword" class="form-label small fw-bold text-uppercase" style="color: #00ff87;">Mật khẩu mới *</label>
                        <div class="input-group" style="background: #0d1f10; border: 1px solid #1a3320; border-radius: 8px; overflow: hidden;">
                            <span class="input-group-text bg-transparent border-0" style="color: #3d7a52;"><i class="bi bi-lock-fill"></i></span>
                            <input asp-for="Input.NewPassword" class="form-control bg-transparent border-0 text-white shadow-none" autocomplete="new-password" aria-required="true" placeholder="Nhập mật khẩu mới..." />
                        </div>
                        <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
                    </div>

                    @* Xác nhận mật khẩu mới *@
                    <div class="mb-4">
                        <label asp-for="Input.ConfirmPassword" class="form-label small fw-bold text-uppercase" style="color: #00ff87;">Xác nhận mật khẩu mới *</label>
                        <div class="input-group" style="background: #0d1f10; border: 1px solid #1a3320; border-radius: 8px; overflow: hidden;">
                            <span class="input-group-text bg-transparent border-0" style="color: #3d7a52;"><i class="bi bi-shield-check"></i></span>
                            <input asp-for="Input.ConfirmPassword" class="form-control bg-transparent border-0 text-white shadow-none" autocomplete="new-password" aria-required="true" placeholder="Nhập lại mật khẩu mới..." />
                        </div>
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn fw-bold text-uppercase px-4 py-2" style="background-color: #00ff87; color: #022c22; border-radius: 8px; box-shadow: 0 4px 14px rgba(0, 255, 135, 0.25);">
                            TẠO MẬT KHẨU
                        </button>
                    </div>

                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
