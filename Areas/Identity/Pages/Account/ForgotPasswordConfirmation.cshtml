@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Đã gửi yêu cầu";
    Layout = null;
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
        font-family: 'Inter', sans-serif;
        background-image: radial-gradient(ellipse at 0% 100%, rgba(0,160,70,0.55) 0%, rgba(0,80,30,0.3) 30%, transparent 55%),
                          radial-gradient(ellipse at 100% 0%, rgba(0,160,70,0.45) 0%, rgba(0,80,30,0.25) 28%, transparent 50%);
        background-color: #010a04;
        background-attachment: fixed;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    .card-box {
        width: 100%;
        max-width: 460px;
        background: #ffffff;
        border-radius: 16px;
        padding: 40px;
        box-shadow: 0 20px 40px rgba(0,0,0,0.4);
        text-align: center;
    }

    .icon-circle {
        width: 80px;
        height: 80px;
        background: rgba(0,255,135,0.12);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 24px auto;
        font-size: 2.5rem;
        color: #16a34a;
    }

    .card-title {
        font-size: 1.8rem;
        font-weight: 700;
        color: #111827;
        margin-bottom: 12px;
        text-transform: uppercase;
        letter-spacing: -0.5px;
    }

    .card-subtitle {
        font-size: 0.95rem;
        color: #4b5563;
        margin-bottom: 32px;
        line-height: 1.6;
    }

    .btn-back {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        width: 100%;
        background: #00ff87;
        color: #022c22;
        font-weight: 700;
        font-size: 1rem;
        padding: 14px;
        border: none;
        border-radius: 8px;
        text-decoration: none;
        transition: all 0.25s ease;
        font-family: 'Inter', sans-serif;
    }

    .btn-back:hover {
        background: #00e676;
        transform: translateY(-1px);
        box-shadow: 0 8px 20px rgba(0,255,135,0.4);
        color: #022c22;
    }
</style>

<div class="card-box">
    <div class="icon-circle">
        <i class="bi bi-envelope-check-fill"></i>
    </div>
    
    <h2 class="card-title">Kiểm tra Email nhé!</h2>
    <p class="card-subtitle">
        Cinema Hub đã gửi một liên kết đặt lại mật khẩu đến Email của bạn.<br>
        Vui lòng kiểm tra hộp thư (và cả mục <b>Thư rác</b>).
    </p>

    <a asp-page="./Login" class="btn-back">
        <i class="bi bi-arrow-left"></i> Quay lại Đăng nhập
    </a>
</div>