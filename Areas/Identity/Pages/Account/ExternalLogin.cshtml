@page
@model ExternalLoginModel
@{
    ViewData["Title"] = "Hoàn tất đăng nhập";
    Layout = null;
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
        font-family: 'Inter', sans-serif;
        background-image: radial-gradient(ellipse at 0% 100%, rgba(0,160,70,0.55) 0%, rgba(0,80,30,0.3) 30%, transparent 55%),
                          radial-gradient(ellipse at 100% 0%, rgba(0,160,70,0.45) 0%, rgba(0,80,30,0.25) 28%, transparent 50%);
        background-color: #010a04;
        background-attachment: fixed;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    .card-box {
        width: 100%;
        max-width: 460px;
        background: #ffffff;
        border-radius: 16px;
        padding: 40px;
        box-shadow: 0 20px 40px rgba(0,0,0,0.4);
    }

    .google-badge {
        display: flex;
        align-items: center;
        gap: 10px;
        background: #f3f4f6;
        border-radius: 10px;
        padding: 12px 16px;
        margin-bottom: 24px;
    }

    .google-badge span {
        font-size: 0.9rem;
        color: #374151;
        font-weight: 500;
    }

    .google-badge strong {
        color: #16a34a;
    }

    .card-title {
        font-size: 1.6rem;
        font-weight: 700;
        color: #111827;
        margin-bottom: 6px;
    }

    .card-subtitle {
        font-size: 0.88rem;
        color: #6b7280;
        margin-bottom: 24px;
    }

    .custom-label {
        font-size: 0.85rem;
        font-weight: 600;
        color: #4b5563;
        display: block;
        margin-bottom: 6px;
    }

    .custom-input {
        width: 100%;
        padding: 12px 16px;
        font-size: 0.95rem;
        color: #1f2937;
        background: #ffffff;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        transition: all 0.2s ease;
        outline: none;
        font-family: 'Inter', sans-serif;
    }

    .custom-input:focus {
        border-color: #00ff87;
        box-shadow: 0 0 0 4px rgba(0,255,135,0.15);
    }

    .btn-confirm {
        width: 100%;
        background: #00ff87;
        color: #022c22;
        font-weight: 700;
        font-size: 1rem;
        padding: 14px;
        border: none;
        border-radius: 8px;
        margin-top: 20px;
        cursor: pointer;
        transition: all 0.25s ease;
        font-family: 'Inter', sans-serif;
    }

    .btn-confirm:hover {
        background: #00e676;
        transform: translateY(-1px);
        box-shadow: 0 8px 20px rgba(0,255,135,0.4);
    }

    .back-link {
        display: block;
        text-align: center;
        margin-top: 16px;
        font-size: 0.88rem;
        color: #6b7280;
        text-decoration: none;
        transition: color 0.2s;
    }

    .back-link:hover { color: #111827; }
    .back-link i { margin-right: 4px; }
</style>

<div class="card-box">

    @* Badge Google *@
    <div class="google-badge">
        <svg width="20" height="20" viewBox="0 0 48 48">
            <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
            <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
            <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
            <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.18 1.48-4.97 2.31-8.16 2.31-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
        </svg>
        <span>Đã xác thực thành công với <strong>Google</strong> ✓</span>
    </div>

    <h2 class="card-title">Một bước nữa thôi!</h2>
    <p class="card-subtitle">Xác nhận email để hoàn tất tạo tài khoản Cinema Hub của bạn.</p>

    <form asp-page-handler="Confirmation" asp-route-returnUrl="@Model.ReturnUrl" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>

        <label asp-for="Input.Email" class="custom-label">Email</label>
        <input asp-for="Input.Email"
               class="custom-input"
               autocomplete="email"
               placeholder="your@email.com" />
        <span asp-validation-for="Input.Email" class="text-danger small d-block mt-1"></span>

        <button type="submit" class="btn-confirm">
            <i class="bi bi-check-circle me-2"></i>Hoàn tất đăng ký
        </button>
    </form>

    <a href="/Identity/Account/Login" class="back-link">
        <i class="bi bi-arrow-left"></i>Quay lại đăng nhập
    </a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
