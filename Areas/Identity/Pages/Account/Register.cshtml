@page
@model RegisterModel
@{
    ViewData["Title"] = "Create an account - Cinema Hub";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

<style>
    body {
        font-family: 'Inter', sans-serif;
        background-color: #010a04;
        background-image: 
            radial-gradient(ellipse at 10% 90%, rgba(0, 255, 135, 0.15) 0%, transparent 50%),
            radial-gradient(ellipse at 90% 10%, rgba(0, 255, 135, 0.15) 0%, transparent 50%),
            linear-gradient(135deg, #010a04 0%, #021a0d 100%);
        background-attachment: fixed;
        min-height: 100vh;
        margin: 0;
        padding: 0;
        position: relative;
        overflow-y: scroll; /* Force scrollbar to prevent layout shift */
    }

    .split-container {
        width: 100%;
        min-height: 100vh;
        display: flex;
        z-index: 1;
    }

    /* 🟢 BÊN TRÁI: BANNER GRADIENT XANH LỤC BẢO HUYỀN BÍ */
    .left-banner {
        width: 50%;
        background: linear-gradient(145deg, #022c22 0%, #061512 60%, #010a04 100%);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 60px 80px;
        color: #ffffff;
        position: relative;
        animation: fadeIn 0.8s ease-out forwards;
    }

    .brand-logo-area img {
        height: 35px;
    }

    .banner-text-heading {
        font-size: 3rem;
        font-weight: 300;
        line-height: 1.2;
        max-width: 480px;
        margin-bottom: 40px;
    }

    .banner-text-heading strong {
        font-weight: 600;
        display: block;
        color: #00ff87; /* Điểm nhấn Neon xanh */
    }

    /* ⚪ BÊN PHẢI: KHÔNG GIAN NHẬP LIỆU GỌN GÀNG (DARK THEME) */
    .right-form-area {
        width: 50%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center; /* Center form horizontally */
        padding: 60px;
        background: rgba(15, 25, 20, 0.45); /* Glassmorphism background */
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        border-left: 1px solid rgba(255, 255, 255, 0.08);
    }
    
    .register-form-wrapper {
        width: 100%;
        max-width: 440px;
        animation: fadeLeft 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        opacity: 0;
        transform: translateX(20px);
    }
    
    @@keyframes fadeLeft {
        to { opacity: 1; transform: translateX(0); }
    }
    
    @@keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    .form-title {
        font-size: 2rem;
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 30px;
    }

    .custom-label-small {
        font-size: 0.85rem;
        font-weight: 600;
        color: #d1d5db;
        margin-bottom: 6px;
        display: block;
    }

    .input-wrapper-figma {
        position: relative;
        margin-bottom: 20px;
    }

    .input-wrapper-figma input {
        width: 100%;
        padding: 12px 16px;
        font-size: 0.95rem;
        color: #ffffff;
        background-color: rgba(0, 0, 0, 0.4);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 8px;
        transition: all 0.2s ease;
        height: 48px; /* Fix iOS Safari password field collapse bug */
        line-height: 1.5;
    }

    /* Bắt buộc dùng font hệ thống và không dùng letter-spacing cho ô nhập mật khẩu trên iOS Safari để tránh lỗi xẹp khung và đơ bàn phím */
    .input-wrapper-figma input[type="password"] {
        font-family: system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
        -webkit-appearance: none;
        appearance: none;
    }

    .input-wrapper-figma input[type="password"]::placeholder {
        letter-spacing: normal;
        font-family: 'Inter', sans-serif;
    }

    .input-wrapper-figma input::placeholder {
        color: #6b7280;
    }

    .input-wrapper-figma input:focus {
        outline: none;
        border-color: #00ff87;
        background-color: rgba(0, 255, 135, 0.03);
        box-shadow: 0 0 0 4px rgba(0, 255, 135, 0.15);
    }

    /* Icon mắt ẩn hiện password */
    .password-toggle-eye {
        position: absolute;
        right: 16px;
        top: 50%;
        transform: translateY(-50%);
        cursor: pointer;
        color: #6b7280;
        font-size: 1.1rem;
        transition: color 0.2s;
    }

    .password-toggle-eye:hover {
        color: #00ff87;
    }

    /* 🟢 NÚT BẤM NEON GREEN SIÊU WOW */
    .btn-create-account-figma {
        width: 100%;
        background: linear-gradient(135deg, #00ff87 0%, #00c060 100%);
        color: #010a04;
        font-weight: 700;
        font-size: 1rem;
        padding: 14px;
        border: none;
        border-radius: 8px;
        margin-top: 10px;
        margin-bottom: 24px;
        cursor: pointer;
        transition: all 0.25s ease;
    }

    .btn-create-account-figma:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(0, 255, 135, 0.3);
    }

    .login-redirect-text {
        font-size: 0.95rem;
        color: #9ca3af;
        text-align: center;
    }

    .login-redirect-text a {
        color: #00ff87;
        font-weight: 600;
        text-decoration: none;
        margin-left: 4px;
        transition: all 0.2s;
    }

    .login-redirect-text a:hover {
        text-decoration: underline;
        text-shadow: 0 0 10px rgba(0,255,135,0.4);
    }

    /* Responsive cho màn hình laptop nhỏ và điện thoại */
    @@media (max-width: 992px) {
        body { padding: 20px; }
        .left-banner { display: none; }
        .right-form-area {
            width: 100%;
            padding: 40px 20px;
            background: transparent;
            border-left: none;
        }
        .split-container {
            width: 100%;
            max-width: 460px;
            min-height: auto;
            border-radius: 20px;
            background: rgba(15, 25, 20, 0.65);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-top: 1px solid rgba(255, 255, 255, 0.15);
            box-shadow: 0 30px 60px rgba(0, 0, 0, 0.6), inset 0 0 0 1px rgba(255,255,255,0.02);
            margin: auto;
            overflow: hidden;
        }
    }
</style>
</head>
<body>
<div class="split-container">
    <div class="left-banner">
        <div class="brand-logo-area">
            <h3 class="fw-bold m-0 text-success" style="letter-spacing: 1px;"><i class="bi bi-film"></i> CinemaHub</h3>
        </div>

        <div class="banner-core-message">
            <h1 class="banner-text-heading">
                Welcome.
                <strong>Begin your cinematic adventure now with our ticketing platform!</strong>
            </h1>
        </div>

        <div class="banner-footer-small">
            <p class="small text-white-50 mb-0">© 2026 Cinema Hub Platform. All rights reserved.</p>
        </div>
    </div>

    <div class="right-form-area">
        <div class="register-form-wrapper">
            <h2 class="form-title">Tạo Tài Khoản</h2>

            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>

                @* ✉️ Trường Email *@
                <div class="mb-3">
                    <label asp-for="Input.Email" class="custom-label-small">Email</label>
                    <div class="input-wrapper-figma">
                        <input asp-for="Input.Email" autocomplete="username" aria-required="true" placeholder="Nhập địa chỉ email..." />
                    </div>
                    <span asp-validation-for="Input.Email" class="text-danger small d-block mt-1"></span>
                </div>

                @* 🔒 Trường Mật khẩu *@
                <div class="mb-3">
                    <label asp-for="Input.Password" class="custom-label-small">Mật khẩu</label>
                    <div class="input-wrapper-figma">
                        <input asp-for="Input.Password" type="password" id="txtPassword" autocomplete="new-password" aria-required="true" placeholder="Tạo mật khẩu..." />
                        <i class="bi bi-eye-slash password-toggle-eye" id="togglePassword"></i>
                    </div>
                    <span asp-validation-for="Input.Password" class="text-danger small d-block mt-1"></span>
                </div>

                @* 🛡️ Trường Xác nhận Mật khẩu *@
                <div class="mb-4">
                    <label asp-for="Input.ConfirmPassword" class="custom-label-small">Xác nhận mật khẩu</label>
                    <div class="input-wrapper-figma">
                        <input asp-for="Input.ConfirmPassword" type="password" id="txtConfirmPassword" autocomplete="new-password" aria-required="true" placeholder="Nhập lại mật khẩu..." />
                        <i class="bi bi-eye-slash password-toggle-eye" id="toggleConfirmPassword"></i>
                    </div>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger small d-block mt-1"></span>
                </div>

                @* Nút Submit phát sáng Neon *@
                <button id="registerSubmit" type="submit" class="btn-create-account-figma shadow">
                    Đăng Ký Ngay
                </button>

                <div class="login-redirect-text">
                    Đã có tài khoản? <a asp-page="./Login">Đăng nhập</a>
                </div>
            </form>
        </div>
    </div>
</div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function () {
            // Hàm toggle cho ô password chính
            $('#togglePassword').on('click', function () {
                const passwordInput = $('#txtPassword');
                const type = passwordInput.attr('type') === 'password' ? 'text' : 'password';
                passwordInput.attr('type', type);

                // Đổi icon mắt đóng/mở
                $(this).toggleClass('bi-eye-slash bi-eye');
            });

            // Hàm toggle cho ô confirm password
            $('#toggleConfirmPassword').on('click', function () {
                const confirmInput = $('#txtConfirmPassword');
                const type = confirmInput.attr('type') === 'password' ? 'text' : 'password';
                confirmInput.attr('type', type);

                $(this).toggleClass('bi-eye-slash bi-eye');
            });
        });
    </script>
</body>
</html>