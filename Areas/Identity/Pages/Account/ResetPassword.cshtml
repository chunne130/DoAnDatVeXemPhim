@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu Cinema Hub";
    Layout = null;
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
        font-family: 'Inter', sans-serif;
        background-image: radial-gradient(ellipse at 0% 100%, rgba(0,160,70,0.55) 0%, rgba(0,80,30,0.3) 30%, transparent 55%),
                          radial-gradient(ellipse at 100% 0%, rgba(0,160,70,0.45) 0%, rgba(0,80,30,0.25) 28%, transparent 50%);
        background-color: #010a04;
        background-attachment: fixed;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    .card-box {
        width: 100%;
        max-width: 460px;
        background: #ffffff;
        border-radius: 16px;
        padding: 40px;
        box-shadow: 0 20px 40px rgba(0,0,0,0.4);
    }

    .icon-circle {
        width: 64px;
        height: 64px;
        background: rgba(0,255,135,0.12);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px auto;
        font-size: 1.8rem;
        color: #16a34a;
    }

    .card-title {
        font-size: 1.65rem;
        font-weight: 700;
        color: #111827;
        text-align: center;
        margin-bottom: 8px;
    }

    .card-subtitle {
        font-size: 0.88rem;
        color: #6b7280;
        text-align: center;
        margin-bottom: 28px;
        line-height: 1.5;
    }

    .custom-label {
        font-size: 0.85rem;
        font-weight: 600;
        color: #4b5563;
        display: block;
        margin-bottom: 6px;
    }

    .input-wrap {
        position: relative;
        margin-bottom: 8px;
    }

    .input-icon {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #9ca3af;
        font-size: 1rem;
    }

    .custom-input {
        width: 100%;
        padding: 12px 16px 12px 42px;
        font-size: 0.95rem;
        color: #1f2937;
        background: #ffffff;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        transition: all 0.2s ease;
        outline: none;
        font-family: 'Inter', sans-serif;
    }

    .custom-input:focus {
        border-color: #00ff87;
        box-shadow: 0 0 0 4px rgba(0,255,135,0.15);
    }

    .btn-submit {
        width: 100%;
        background: #00ff87;
        color: #022c22;
        font-weight: 700;
        font-size: 1rem;
        padding: 14px;
        border: none;
        border-radius: 8px;
        margin-top: 10px;
        margin-bottom: 16px;
        cursor: pointer;
        transition: all 0.25s ease;
        font-family: 'Inter', sans-serif;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .btn-submit:hover {
        background: #00e676;
        transform: translateY(-1px);
        box-shadow: 0 8px 20px rgba(0,255,135,0.4);
    }

    .back-link {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        font-size: 0.88rem;
        color: #6b7280;
        text-decoration: none;
        transition: color 0.2s;
    }

    .back-link:hover { color: #111827; }
</style>

<div class="card-box">

    <div class="icon-circle">
        <i class="bi bi-shield-check"></i>
    </div>

    <h2 class="card-title">Mật khẩu mới</h2>
    <p class="card-subtitle">Thiết lập mật khẩu mới cho tài khoản của bạn để tiếp tục sử dụng Cinema Hub.</p>

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>
        <input asp-for="Input.Code" type="hidden" />

        <div class="mb-3">
            <label asp-for="Input.Email" class="custom-label">Tài khoản Email</label>
            <div class="input-wrap">
                <i class="bi bi-envelope-fill input-icon"></i>
                <input asp-for="Input.Email" class="custom-input" placeholder="Nhập email của bạn..." />
            </div>
            <span asp-validation-for="Input.Email" class="text-danger small d-block mt-1"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.Password" class="custom-label">Mật khẩu mới</label>
            <div class="input-wrap">
                <i class="bi bi-key-fill input-icon"></i>
                <input asp-for="Input.Password" class="custom-input" autocomplete="new-password" placeholder="Nhập pass mới..." />
            </div>
            <span asp-validation-for="Input.Password" class="text-danger small d-block mt-1"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Input.ConfirmPassword" class="custom-label">Xác nhận lại</label>
            <div class="input-wrap">
                <i class="bi bi-check-circle-fill input-icon"></i>
                <input asp-for="Input.ConfirmPassword" class="custom-input" autocomplete="new-password" placeholder="Nhập lại pass mới..." />
            </div>
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small d-block mt-1"></span>
        </div>

        <button type="submit" class="btn-submit">
            Cập nhật mật khẩu <i class="bi bi-arrow-right-short fs-5"></i>
        </button>
    </form>

    <a asp-page="./Login" class="back-link">
        <i class="bi bi-arrow-left"></i> Quay lại đăng nhập
    </a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}