@model DoAnDatVeXemPhim.Models.CustomerProfile

@{
    Layout = Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest" ? null : "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card border-0 shadow-lg slide-in-bottom" style="background: rgba(17, 24, 39, 0.8); backdrop-filter: blur(16px); border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 20px;">

                <div class="card-body p-5 text-center">
                    <div class="mb-4" style="text-shadow: 0 0 20px rgba(239,68,68,0.4);">
                        <i class="bi bi-person-x-fill text-danger display-1"></i>
                    </div>

                    <h3 class="fw-bold text-white mb-3 text-uppercase">XÓA TÀI KHOẢN NÀY?</h3>
                    <p style="color: #9ca3af; font-size: 0.95rem;" class="mb-4 px-3">
                        Lưu ý: Hành động này sẽ xóa vĩnh viễn cả Profile và dữ liệu đăng nhập của thành viên <strong class="text-white fs-5 d-block mt-2">@Model.FullName</strong>
                    </p>

                    <div class="text-start p-4 rounded-4 mb-4" style="background: rgba(0,0,0,0.4); border: 1px dashed rgba(239, 68, 68, 0.3);">
                        <div class="d-flex justify-content-between border-bottom pb-2 mb-3" style="border-color: rgba(255,255,255,0.05) !important;">
                            <span class="small fw-bold text-uppercase" style="color: #ef4444; letter-spacing: 1px;">CHI TIẾT DỮ LIỆU BỊ XÓA</span>
                            <span class="badge" style="background: rgba(239, 68, 68, 0.15); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.3);">ID: #@Model.Id</span>
                        </div>
                        <p class="mb-2 text-white"><i class="bi bi-envelope me-2" style="color: #60a5fa;"></i> Email: <span class="fw-bold">@(Model.User?.Email ?? "N/A")</span></p>
                        <p class="mb-2 text-white"><i class="bi bi-calendar3 me-2" style="color: #fbbf24;"></i> Sinh nhật: @(Model.Birthday?.ToString("dd/MM/yyyy") ?? "N/A")</p>
                        <p class="mb-0 text-white"><i class="bi bi-geo-alt me-2" style="color: #00ff87;"></i> Khu vực: @Model.District, @Model.City</p>
                    </div>

                    <form id="deleteUserForm" asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="UserId" />

                        <div class="d-grid gap-3 d-sm-flex justify-content-sm-center mt-5">
                            <a asp-action="Index" class="btn btn-outline-light btn-lg px-5 rounded-pill fw-bold ajax-link" style="border-color: rgba(255,255,255,0.2);">
                                ĐỔI Ý, QUAY LẠI
                            </a>
                            <button type="submit" class="btn btn-danger btn-lg px-5 rounded-pill fw-bold shadow" style="background: #ef4444; border: none;">
                                <i class="bi bi-trash3-fill me-2"></i> XÓA VĨNH VIỄN
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $('#deleteUserForm').on('submit', function(e) {
        e.preventDefault();
        var $form = $(this);
        var $contentBox = $('#admin-dynamic-content');
        var $loader = $('#admin-loader');
        $contentBox.css('opacity', '0.3'); $loader.fadeIn(200);

        $.ajax({
            url: $form.attr('action'), type: $form.attr('method'), data: $form.serialize(),
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
            success: function (res) {
                // Xóa xong múc lại trang Index
                $.ajax({
                    url: '/CustomerProfiles/Index', type: 'GET', headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    success: function (html) {
                        var $dummy = $('<div>').append($.parseHTML(html));
                        var $inner = $dummy.find('#admin-dynamic-content');
                        if ($inner.length > 0) { $contentBox.html($inner.html()); } else { $contentBox.html(html); }
                        $loader.fadeOut(200, function() { $contentBox.css('opacity', '1'); });
                    }
                });
            }
        });
    });
</script>
