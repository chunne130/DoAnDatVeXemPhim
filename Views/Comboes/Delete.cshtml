@model DoAnDatVeXemPhim.Models.Combo

@{
    ViewData["Title"] = "Xác nhận xóa Combo";
    Layout = Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest" ? null : "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    * {
        box-sizing: border-box;
        font-family: 'Inter', sans-serif;
    }

    .delete-wrap {
        padding: 24px 20px;
        display: flex;
        justify-content: center;
    }

    .delete-card {
        width: 100%;
        max-width: 480px;
        background: rgba(10,22,13,0.8);
        backdrop-filter: blur(14px);
        border: 1px solid rgba(239,68,68,0.2);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 0 30px rgba(239,68,68,0.06);
    }

    .warning-top {
        background: rgba(239,68,68,0.08);
        border-bottom: 1px solid rgba(239,68,68,0.12);
        padding: 28px 24px;
        text-align: center;
    }

        .warning-top i {
            font-size: 2.8rem;
            color: #ef4444;
            display: block;
            margin-bottom: 10px;
            animation: pulse 1.5s infinite;
        }

    @@keyframes pulse {
        0%, 100% {
            transform: scale(1);
            opacity: 1;
        }

        50% {
            transform: scale(1.1);
            opacity: 0.8;
        }
    }

    .warning-title {
        font-size: 1.1rem;
        font-weight: 800;
        color: #ef4444;
        text-transform: uppercase;
        margin: 0;
    }

    .warning-sub {
        font-size: 0.75rem;
        color: #6b8c78;
        margin: 6px 0 0;
    }

        .warning-sub strong {
            color: #ef4444;
        }

    .card-body-custom {
        padding: 22px 24px 20px;
    }

    .combo-info {
        display: flex;
        align-items: center;
        gap: 14px;
        background: rgba(0,0,0,0.25);
        border: 1px solid rgba(255,255,255,0.05);
        border-radius: 10px;
        padding: 14px 16px;
        margin-bottom: 22px;
    }

        .combo-info img {
            width: 72px;
            height: 72px;
            object-fit: cover;
            border-radius: 8px;
            border: 1px solid rgba(255,255,255,0.08);
            flex-shrink: 0;
        }

    .combo-name {
        font-size: 0.9rem;
        font-weight: 700;
        color: #fff;
        margin-bottom: 3px;
    }

    .combo-price {
        font-size: 0.85rem;
        font-weight: 700;
        color: #00ff87;
        margin-bottom: 3px;
    }

    .combo-desc {
        font-size: 0.72rem;
        color: #6b8c78;
        line-height: 1.4;
    }

    .combo-id {
        font-size: 0.68rem;
        color: #3d6650;
        margin-top: 4px;
    }

    .btn-delete {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        background: #ef4444;
        border: none;
        color: #fff;
        font-size: 0.85rem;
        font-weight: 700;
        padding: 12px;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.2s;
        margin-bottom: 10px;
    }

        .btn-delete:hover {
            background: #dc2626;
            transform: translateY(-1px);
            box-shadow: 0 6px 18px rgba(239,68,68,0.35);
        }

    .btn-cancel {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        background: transparent;
        border: 1px solid rgba(255,255,255,0.12);
        color: #9ca3af;
        font-size: 0.82rem;
        font-weight: 600;
        padding: 10px;
        border-radius: 8px;
        text-decoration: none;
        transition: all 0.2s;
        cursor: pointer;
    }

        .btn-cancel:hover {
            border-color: rgba(255,255,255,0.28);
            color: #fff;
        }
</style>

<div class="delete-wrap">
    <div class="delete-card">

        <div class="warning-top">
            <i class="bi bi-trash3-fill"></i>
            <h4 class="warning-title">Xóa Combo này?</h4>
            <p class="warning-sub">Hành động này <strong>không thể hoàn tác</strong> — combo sẽ bị xóa vĩnh viễn!</p>
        </div>

        <div class="card-body-custom">
            <div class="combo-info">
                <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "https://via.placeholder.com/80x80/0d1f10/00ff87?text=Combo" : Model.ImageUrl)"
                     alt="@Model.Name" />
                <div>
                    <div class="combo-name">@Model.Name</div>
                    <div class="combo-price">@Model.Price.ToString("N0") VNĐ</div>
                    <div class="combo-desc">@Model.Description</div>
                    <div class="combo-id">Mã Combo: #@Model.Id</div>
                </div>
            </div>

            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn-delete">
                    <i class="bi bi-exclamation-octagon-fill"></i> Xác nhận xóa ngay
                </button>
            </form>

            <button class="btn-cancel" onclick="window.closeComboModal()">
                <i class="bi bi-arrow-left"></i> Không, giữ lại
            </button>
        </div>

    </div>
</div>

