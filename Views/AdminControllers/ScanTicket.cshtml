@{
    ViewData["Title"] = "Soát Vé & Check-in";
    Layout = Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest" ? null : "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="dashboard-panel-card p-4" style="background: rgba(17,24,39,0.7); border: 1px solid rgba(255,255,255,0.05); border-radius: 16px;">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom" style="border-color: rgba(255,255,255,0.05) !important;">
        <div>
            <h4 class="fw-bold m-0 text-uppercase" style="color: #00ff87; text-shadow: 0 0 10px rgba(0,255,135,0.3);"><i class="bi bi-qr-code-scan me-2"></i> Hệ Thống Soát Vé</h4>
            <p class="text-muted small m-0 mt-1">Quét mã QR trên vé điện tử của khách hàng</p>
        </div>
        <span class="badge px-3 py-2 animate-pulse" style="background: rgba(0,255,135,0.15); color: #00ff87; border: 1px solid rgba(0,255,135,0.3); font-size: 0.85rem;">
            <i class="bi bi-broadcast me-1"></i> Trực tuyến
        </span>
    </div>

    <div class="row gx-5">
        <div class="col-lg-6 mb-4 mb-lg-0">
            <div class="scanner-container position-relative p-2" style="background: rgba(0,0,0,0.4); border-radius: 16px; border: 1px solid rgba(0,255,135,0.2); box-shadow: 0 0 20px rgba(0,255,135,0.05);">
                <div id="reader" style="width: 100%; border-radius: 12px; overflow: hidden; background: #000;"></div>
                
                <!-- Hiệu ứng quét -->
                <div class="scan-line"></div>
            </div>

            <div class="mt-4 p-4 rounded-3" style="background: rgba(255,255,255,0.02); border: 1px dashed rgba(255,255,255,0.1);">
                <label class="form-label text-muted small fw-bold text-uppercase"><i class="bi bi-keyboard me-1"></i> Xử lý thủ công</label>
                <div class="input-group mt-1">
                    <span class="input-group-text bg-dark border-secondary text-white" style="border-radius: 8px 0 0 8px;"><i class="bi bi-hash"></i></span>
                    <input type="number" id="manualOrderId" class="form-control bg-dark border-secondary text-white" placeholder="Nhập mã đơn hàng..." style="box-shadow: none;">
                    <button class="btn btn-action-pill ms-2 fw-bold" style="border-radius: 8px; background: rgba(0,255,135,0.15); color: #00ff87; border: 1px solid rgba(0,255,135,0.3);" type="button" onclick="verifyTicketManual()">
                        <i class="bi bi-check2-circle me-1"></i> Kiểm tra
                    </button>
                </div>
            </div>
        </div>
        
        <div class="col-lg-6">
            <div id="scanResult" class="h-100 p-4 rounded-4 d-flex flex-column justify-content-center align-items-center text-center transition-all" 
                 style="background: rgba(255,255,255,0.02); border: 2px dashed rgba(255,255,255,0.08); min-height: 400px;">
                
                <div class="idle-state">
                    <div class="position-relative d-inline-block mb-4">
                        <i class="bi bi-qr-code text-muted" style="font-size: 5rem; opacity: 0.3;"></i>
                        <i class="bi bi-upc-scan position-absolute top-50 start-50 translate-middle text-primary" style="font-size: 2rem; opacity: 0.5;"></i>
                    </div>
                    <h5 class="text-white fw-bold">Sẵn sàng chờ quét mã...</h5>
                    <p class="text-muted mb-0">Đưa camera sát vào mã QR của vé</p>
                </div>

            </div>
        </div>
    </div>
</div>

<style>
    .transition-all {
        transition: all 0.3s ease;
    }
    
    /* Hiệu ứng tia quét ngang qua màn hình camera */
    .scan-line {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 2px;
        background: #00ff87;
        box-shadow: 0 0 10px #00ff87, 0 0 20px #00ff87;
        animation: scanning 2.5s infinite linear;
        pointer-events: none;
        z-index: 10;
        opacity: 0.7;
    }
    
    @@keyframes scanning {
        0% { top: 5%; opacity: 0; }
        10% { opacity: 0.7; }
        90% { opacity: 0.7; }
        100% { top: 95%; opacity: 0; }
    }
    
    #reader__dashboard_section_csr button {
        background: rgba(0,255,135,0.1) !important;
        color: #00ff87 !important;
        border: 1px solid rgba(0,255,135,0.3) !important;
        border-radius: 6px !important;
        padding: 5px 15px !important;
        margin: 5px !important;
    }
    #reader__dashboard_section_swaplink {
        color: #60a5fa !important;
        text-decoration: none !important;
    }
</style>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    var html5QrcodeScanner = null;
    var lastScannedId = null;
    var resultResetTimer = null;

    function initScanner() {
        if (typeof Html5QrcodeScanner === 'undefined') return;
        
        if(html5QrcodeScanner) {
            html5QrcodeScanner.clear();
        }
        
        html5QrcodeScanner = new Html5QrcodeScanner(
            "reader", 
            { 
                fps: 30, 
                qrbox: {width: 250, height: 250},
                formatsToSupport: [ Html5QrcodeSupportedFormats.QR_CODE ],
                disableFlip: false
            },
            false);
            
        html5QrcodeScanner.render(onScanSuccess, onScanError);
    }

    function loadScanner() {
        if (typeof Html5QrcodeScanner !== 'undefined') {
            if (document.getElementById("reader")) initScanner();
        } else {
            $.getScript("https://unpkg.com/html5-qrcode", function() {
                if (document.getElementById("reader")) initScanner();
            });
        }
    }

    loadScanner();


    function playBeep(success) {
        try {
            const AudioContext = window.AudioContext || window.webkitAudioContext;
            const ctx = new AudioContext();
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            
            osc.connect(gain);
            gain.connect(ctx.destination);
            
            if (success) {
                osc.type = 'sine';
                osc.frequency.setValueAtTime(1200, ctx.currentTime);
                gain.gain.setValueAtTime(0.1, ctx.currentTime);
                osc.start();
                osc.stop(ctx.currentTime + 0.1);
            } else {
                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(300, ctx.currentTime);
                gain.gain.setValueAtTime(0.1, ctx.currentTime);
                osc.start();
                osc.stop(ctx.currentTime + 0.3);
            }
        } catch(e) { console.log(e); }
    }

    function onScanSuccess(decodedText, decodedResult) {
        if (decodedText === lastScannedId) return;
        lastScannedId = decodedText;
        
        // Hủy việc lock scan sau 4s
        setTimeout(() => { lastScannedId = null; }, 4000);

        var match = decodedText.match(/TICKET-(\d+)/i);
        var orderIdMatch = decodedText.match(/orderId=(\d+)/i);
        var orderId = parseInt(decodedText);
        
        if (match && match[1]) {
            callVerifyApi(parseInt(match[1]));
        } else if (orderIdMatch && orderIdMatch[1]) {
            callVerifyApi(parseInt(orderIdMatch[1]));
        } else if (!isNaN(orderId)) {
            callVerifyApi(orderId);
        } else {
            showResult(false, "Mã QR không hợp lệ!");
        }
    }

    function onScanError(errorMessage) {
        // Bỏ qua lỗi quét
    }

    function verifyTicketManual() {
        var val = $('#manualOrderId').val();
        if (val) {
            callVerifyApi(val);
        }
    }

    function callVerifyApi(orderId) {
        var $resultBox = $('#scanResult');
        
        // Loading state
        $resultBox.html(`
            <div class="spinner-border" style="color: #00ff87; width: 3rem; height: 3rem;" role="status"></div>
            <h5 class="mt-4 text-white fw-bold">Đang xác thực mã...</h5>
            <p class="text-muted small">Vui lòng đợi giây lát</p>
        `).removeClass('border-success border-danger').css({'background': 'rgba(255,255,255,0.02)', 'border-style': 'dashed'});

        $.ajax({
            url: '/AdminControllers/VerifyTicket',
            type: 'POST',
            data: { orderId: orderId },
            success: function(res) {
                if (res.success) {
                    playBeep(true);
                    showResult(true, res.message, res.customerName, res.movieName, orderId);
                    
                    Swal.fire({
                        icon: 'success',
                        title: 'Soát vé thành công!',
                        text: res.message,
                        background: '#1f2937',
                        color: '#fff',
                        timer: 2000,
                        showConfirmButton: false,
                        toast: true,
                        position: 'top-end'
                    });
                } else {
                    playBeep(false);
                    showResult(false, res.message, null, null, orderId);
                    
                    Swal.fire({
                        icon: 'error',
                        title: 'Vé không hợp lệ',
                        text: res.message,
                        background: '#1f2937',
                        color: '#fff',
                        timer: 3000,
                        showConfirmButton: false,
                        toast: true,
                        position: 'top-end'
                    });
                }
            },
            error: function() {
                playBeep(false);
                showResult(false, "Lỗi kết nối tới máy chủ, vui lòng thử lại!");
            }
        });
    }

    function showResult(isSuccess, message, customerName, movieName, orderId) {
        var $resultBox = $('#scanResult');
        clearTimeout(resultResetTimer);
        
        if (isSuccess) {
            $resultBox.css({'border-style': 'solid', 'background': 'rgba(0, 255, 135, 0.05)'})
                      .removeClass('border-danger').addClass('border-success');
            
            $resultBox.html(`
                <div class="mb-4">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 100px; height: 100px; background: rgba(0, 255, 135, 0.2); box-shadow: 0 0 30px rgba(0,255,135,0.3);">
                        <i class="bi bi-check-lg" style="font-size: 4rem; color: #00ff87;"></i>
                    </div>
                </div>
                <h4 class="fw-bold text-white mb-2">VÉ HỢP LỆ</h4>
                <div class="badge mb-4 px-3 py-2" style="background: rgba(0,255,135,0.15); color: #00ff87; border: 1px solid rgba(0,255,135,0.3);">
                    Đơn hàng #` + (orderId || '') + `
                </div>
                
                <div class="w-100 px-lg-5 text-start">
                    <div class="p-3 rounded-3 mb-2" style="background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.05);">
                        <div class="text-muted small mb-1">Khách hàng</div>
                        <div class="fw-bold text-white fs-6">`+customerName+`</div>
                    </div>
                    <div class="p-3 rounded-3" style="background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.05);">
                        <div class="text-muted small mb-1">Suất chiếu / Phim</div>
                        <div class="fw-bold" style="color: #fbbf24; font-size: 1.1rem;">`+movieName+`</div>
                    </div>
                </div>
            `);
        } else {
            $resultBox.css({'border-style': 'solid', 'background': 'rgba(239, 68, 68, 0.05)'})
                      .removeClass('border-success').addClass('border-danger');
            
            $resultBox.html(`
                <div class="mb-4">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 100px; height: 100px; background: rgba(239, 68, 68, 0.2); box-shadow: 0 0 30px rgba(239,68,68,0.3);">
                        <i class="bi bi-x-lg" style="font-size: 4rem; color: #ef4444;"></i>
                    </div>
                </div>
                <h4 class="fw-bold text-danger mb-2 text-uppercase">Không Hợp Lệ</h4>
                ${orderId ? `<div class="badge mb-4 bg-dark text-muted border border-secondary">Đơn hàng #`+orderId+`</div>` : ''}
                
                <div class="alert alert-danger w-100 p-3 text-start border-0" style="background: rgba(239, 68, 68, 0.1); color: #fca5a5;">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> <strong>Lý do:</strong><br>
                    <span class="mt-1 d-block">` + message + `</span>
                </div>
            `);
        }
        
        resultResetTimer = setTimeout(function() {
            $resultBox.css({'border-style': 'dashed', 'background': 'rgba(255,255,255,0.02)'})
                      .removeClass('border-success border-danger');
            $resultBox.html(`
                <div class="idle-state">
                    <div class="position-relative d-inline-block mb-4">
                        <i class="bi bi-qr-code text-muted" style="font-size: 5rem; opacity: 0.3;"></i>
                        <i class="bi bi-upc-scan position-absolute top-50 start-50 translate-middle text-primary" style="font-size: 2rem; opacity: 0.5;"></i>
                    </div>
                    <h5 class="text-white fw-bold">Sẵn sàng chờ quét mã...</h5>
                    <p class="text-muted mb-0">Đưa camera sát vào mã QR của vé</p>
                </div>
            `);
            $('#manualOrderId').val('');
        }, 10000);
    }
</script>
