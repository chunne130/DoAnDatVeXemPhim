@model DoAnDatVeXemPhim.Models.Actor

@{
    Layout = Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest" ? null : "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="dashboard-panel-card slide-in-bottom">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3" style="border-color: rgba(255,255,255,0.05) !important;">
        <div>
            <h4 class="fw-bold m-0 text-uppercase" style="color: #00ff87; letter-spacing: 0.5px; text-shadow: 0 0 10px rgba(0,255,135,0.2);">
                <i class="bi bi-pencil-square me-2"></i> CẬP NHẬT DIỄN VIÊN
            </h4>
            <p class="text-muted small m-0 mt-1">Chỉnh sửa thông tin diễn viên trong hệ thống</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary text-light ajax-link rounded-pill px-4 fw-bold shadow-sm">
            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
        </a>
    </div>

    <form id="editActorForm" asp-action="Edit" method="post" class="ajax-form">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input type="hidden" asp-for="Id" />

        <div class="row g-4 justify-content-center">
            <div class="col-md-8">
                <h6 class="fw-bold text-uppercase mb-4" style="color: #00ff87;"><i class="bi bi-person-lines-fill me-1"></i> THÔNG TIN DIỄN VIÊN</h6>

                <div class="mb-4">
                    <label asp-for="Name" class="form-label fw-bold small text-muted">TÊN DIỄN VIÊN</label>
                    <input asp-for="Name" class="form-control form-control-neon" placeholder="Nhập tên diễn viên..." />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ProfilePictureUrl" class="form-label fw-bold small text-muted">ĐƯỜNG DẪN ẢNH ĐẠI DIỆN</label>
                    <input asp-for="ProfilePictureUrl" class="form-control form-control-neon" placeholder="https://..." />
                    <span asp-validation-for="ProfilePictureUrl" class="text-danger small"></span>
                </div>

                <div class="mt-5 pt-4 border-top text-end" style="border-color: rgba(255,255,255,0.05) !important;">
                    <button type="submit" class="btn btn-save-neon px-5 py-2 fw-bold rounded-pill text-uppercase shadow-sm">
                        <i class="bi bi-save-fill me-2"></i> LƯU THAY ĐỔI
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<style>
    .form-control-neon {
        background-color: rgba(0, 0, 0, 0.4) !important;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        color: #fff !important;
        border-radius: 8px;
        padding: 12px 16px;
        transition: all 0.3s;
    }
    .form-control-neon:focus {
        border-color: #00ff87 !important;
        box-shadow: 0 0 0 3px rgba(0, 255, 135, 0.15) !important;
    }
    .btn-save-neon {
        background-color: #00ff87;
        color: #022c22;
        border: none;
        transition: all 0.2s;
    }
    .btn-save-neon:hover {
        background-color: #00e676;
        box-shadow: 0 0 15px rgba(0, 255, 135, 0.4);
        transform: translateY(-2px);
    }
    .slide-in-bottom {
        animation: slideIn 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
    }
    @@keyframes slideIn {
        0% { transform: translateY(20px); opacity: 0; }
        100% { transform: translateY(0); opacity: 1; }
    }
</style>
