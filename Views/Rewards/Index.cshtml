@using DoAnDatVeXemPhim.Models
@{
    ViewData["Title"] = "Trung tâm Ưu đãi & Đổi điểm";
    var profile = ViewBag.Profile as CustomerProfile;
    var availablePromos = ViewBag.AvailablePromotions as List<Promotion>;
    var userPromos = ViewBag.UserPromotions as List<UserPromotion>;
}

<div class="container-xl mt-5 pt-5 pb-5">
    <div class="row gx-5">
        <!-- CỘT TRÁI: THÔNG TIN ĐIỂM SỐ -->
        <div class="col-md-4 mb-4">
            <div class="card bg-dark text-white border-0 shadow-lg" style="border-radius: 16px;">
                <div class="card-body p-4 text-center">
                    <h5 class="text-uppercase text-muted fw-bold mb-3" style="letter-spacing: 2px;">Điểm Thưởng Của Bạn</h5>
                    <div class="display-3 fw-bold mb-2" style="color: #00ff87;">
                        <i class="bi bi-star-fill text-warning me-2" style="font-size: 2.5rem;"></i><span id="userPoints">@profile.RewardPoints</span>
                    </div>
                    <p class="text-muted mb-4">Quy đổi: 10.000đ = 1 điểm</p>
                    
                    <div class="p-3 rounded text-start" style="background: rgba(255,255,255,0.05);">
                        <h6 class="fw-bold mb-2 text-white">Hạng Thành Viên Hiện Tại</h6>
                        <div class="d-flex align-items-center">
                            <span class="badge" style="font-size:1rem; background: linear-gradient(45deg, #fbbf24, #f59e0b);">
                                @profile.MembershipLevel?.LevelName
                            </span>
                            <span class="ms-auto text-muted small">Giảm @profile.MembershipLevel?.DiscountRate %</span>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- VÍ VOUCHER CỦA BẠN -->
            <div class="mt-4">
                <h4 class="fw-bold text-white mb-3"><i class="bi bi-wallet2 text-success me-2"></i>Ví Voucher Của Bạn</h4>
                @if (userPromos != null && userPromos.Any())
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var up in userPromos)
                        {
                            <div class="card border-0 text-white shadow-sm position-relative overflow-hidden" 
                                 style="background: #1a1a2e; border-radius: 12px; @(up.IsUsed ? "opacity: 0.6; filter: grayscale(1);" : "border-left: 4px solid #00ff87 !important;")">
                                <div class="card-body p-3">
                                    <h6 class="fw-bold mb-1 text-warning">@up.Promotion.VoucherCode</h6>
                                    <p class="small mb-1">@(up.Promotion.IsPercentage ? $"Giảm {up.Promotion.DiscountValue}%" : $"Giảm {up.Promotion.DiscountValue:N0}đ")</p>
                                    <p class="small text-muted mb-0" style="font-size: 0.75rem;">HSD: @up.Promotion.EndDate.ToString("dd/MM/yyyy HH:mm")</p>
                                    
                                    @if (up.IsUsed)
                                    {
                                        <span class="badge bg-secondary position-absolute top-0 end-0 m-2">Đã dùng</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success position-absolute top-0 end-0 m-2">Khả dụng</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert text-muted" style="background: rgba(255,255,255,0.05); border: 1px dashed rgba(255,255,255,0.2);">
                        Bạn chưa có voucher nào trong ví. Hãy đổi điểm ngay nhé!
                    </div>
                }
            </div>
        </div>

        <!-- CỘT PHẢI: DANH SÁCH ĐỔI QUÀ -->
        <div class="col-md-8">
            <h3 class="fw-bold text-white mb-4"><i class="bi bi-gift text-danger me-2"></i>Trung Tâm Đổi Điểm</h3>
            
            @if (availablePromos != null && availablePromos.Any())
            {
                <div class="row row-cols-1 row-cols-md-2 g-4">
                    @foreach (var p in availablePromos)
                    {
                        var isAffordable = profile.RewardPoints >= p.PointsRequired;
                        
                        <div class="col">
                            <div class="card h-100 border-0 bg-dark text-white shadow-sm" style="border-radius: 12px; transition: transform 0.2s;">
                                <div class="card-header border-0 d-flex justify-content-between align-items-center" style="background: rgba(255,255,255,0.05); border-radius: 12px 12px 0 0;">
                                    <span class="fw-bold text-warning" style="font-size: 1.1rem;">@p.VoucherCode</span>
                                    <span class="badge rounded-pill bg-danger"><i class="bi bi-star-fill me-1"></i>@p.PointsRequired điểm</span>
                                </div>
                                <div class="card-body">
                                    <h5 class="card-title text-success fw-bold">
                                        @(p.IsPercentage ? $"Giảm {p.DiscountValue}%" : $"Giảm {p.DiscountValue:N0}đ")
                                    </h5>
                                    <p class="card-text text-muted small mb-2">Đơn tối thiểu: @p.MinOrderValue:N0 đ</p>
                                    <p class="card-text text-muted small">HSD: @p.EndDate.ToString("dd/MM/yyyy HH:mm")</p>
                                    
                                    @if(p.MembershipLevelId != null)
                                    {
                                        <p class="small mb-0 text-info"><i class="bi bi-shield-check me-1"></i>Chỉ dành cho: @p.MembershipLevel.LevelName</p>
                                    }
                                </div>
                                <div class="card-footer border-0 bg-transparent text-end pb-3 pe-3">
                                    <button class="btn @(isAffordable ? "btn-outline-success" : "btn-outline-secondary disabled") px-4 rounded-pill btn-exchange"
                                            data-id="@p.Id" data-code="@p.VoucherCode" data-points="@p.PointsRequired"
                                            @(isAffordable ? "" : "disabled")>
                                        @(isAffordable ? "Đổi mã ngay" : "Không đủ điểm")
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert text-center py-5" style="background: rgba(255,255,255,0.05); border-radius: 12px;">
                    <i class="bi bi-box-seam text-muted display-4 d-block mb-3"></i>
                    <p class="text-muted mb-0">Hiện tại không có Voucher nào khả dụng để đổi.</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function () {
            $('.btn-exchange').click(function () {
                var btn = $(this);
                var promoId = btn.data('id');
                var code = btn.data('code');
                var points = btn.data('points');

                Swal.fire({
                    title: 'Xác nhận đổi mã?',
                    html: `Bạn có chắc chắn muốn dùng <b class="text-warning">${points} điểm</b> để đổi voucher <b class="text-success">${code}</b> không?`,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#00ff87',
                    cancelButtonColor: '#dc3545',
                    confirmButtonText: '<span style="color:#010a04;font-weight:bold;">Đổi ngay</span>',
                    cancelButtonText: 'Suy nghĩ lại'
                }).then((result) => {
                    if (result.isConfirmed) {
                        // Gửi AJAX
                        $.post('/Rewards/Exchange', { promotionId: promoId }, function (res) {
                            if (res.success) {
                                Swal.fire({
                                    title: 'Thành công!',
                                    text: res.message,
                                    icon: 'success',
                                    timer: 2000,
                                    showConfirmButton: false
                                });
                                // CẬP NHẬT GIAO DIỆN NGAY LẬP TỨC KHÔNG CẦN RELOAD TẢI TRANG
                                let currentPoints = parseInt(document.getElementById('userPoints').innerText.replace(/\D/g, ''));
                                document.getElementById('userPoints').innerText = (currentPoints - points);
                                // Reload sau 2s để danh sách render đúng
                                setTimeout(() => location.reload(), 2000);
                            } else {
                                Swal.fire({
                                    title: 'Thất bại!',
                                    text: res.message,
                                    icon: 'error',
                                    confirmButtonColor: '#dc3545'
                                });
                            }
                        }).fail(function () {
                            Swal.fire('Lỗi', 'Không thể kết nối đến máy chủ.', 'error');
                        });
                    }
                });
            });
        });
    </script>
}
