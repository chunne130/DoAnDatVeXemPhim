@model DoAnDatVeXemPhim.Models.Movie

<div class="dashboard-panel-card slide-in-bottom">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3" style="border-color: rgba(255,255,255,0.05) !important;">
        <div>
            <h4 class="fw-bold m-0 text-uppercase" style="color: #00ff87; letter-spacing: 0.5px; text-shadow: 0 0 10px rgba(0,255,135,0.2);">
                <i class="bi bi-info-square me-2"></i> Chi tiết siêu phẩm
            </h4>
            <p class="text-muted small m-0 mt-1">Hồ sơ thông tin điện ảnh</p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary text-light ajax-link rounded-pill px-4 fw-bold">
            <i class="bi bi-arrow-left me-1"></i> Quay lại kho
        </a>
    </div>

    <div class="row g-5">
        <div class="col-md-4 text-center">
            <div class="position-relative d-inline-block rounded-4 overflow-hidden shadow-lg" style="border: 1px solid rgba(0,255,135,0.3);">
                <img src="@Model.PosterUrl" alt="@Model.Title" class="img-fluid w-100" style="max-height: 480px; object-fit: cover;" />
                <div class="position-absolute top-0 start-0 w-100 h-100" style="background: linear-gradient(to bottom, transparent 70%, rgba(0,0,0,0.9));"></div>
                <div class="position-absolute bottom-0 start-0 w-100 p-3 text-center">
                    <span class="badge" style="background: rgba(0,255,135,0.2); color: #00ff87; border: 1px solid rgba(0,255,135,0.5); font-size: 1rem;">
                        NĂM @(Model.ReleaseDate?.ToString("yyyy") ?? "N/A")
                    </span>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <h2 class="fw-black text-uppercase text-white mb-4" style="letter-spacing: 1px; text-shadow: 0 2px 10px rgba(0,0,0,0.5);">@Model.Title</h2>

            <div class="d-flex flex-wrap gap-3 mb-4">
                <div class="px-4 py-2 rounded-3" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);">
                    <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.65rem; letter-spacing: 1px;">Thể loại</small>
                    <span class="text-warning fw-bold fs-6">@(Model.Genres != null && Model.Genres.Any() ? string.Join(", ", Model.Genres.Select(g => g.Name)) : "Chưa xác định")</span>
                </div>
                <div class="px-4 py-2 rounded-3" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);">
                    <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.65rem; letter-spacing: 1px;">Thời lượng</small>
                    <span class="text-info fw-bold fs-6"><i class="bi bi-clock me-1"></i> @Model.Duration phút</span>
                </div>
                <div class="px-4 py-2 rounded-3" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);">
                    <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.65rem; letter-spacing: 1px;">Trạng thái</small>
                    <span class="text-success fw-bold fs-6"><i class="bi bi-play-circle me-1"></i> Đang chiếu</span>
                </div>
                
                @* --- ĐÃ THÊM: Tính năng Behavior Tracking (ViewCount) --- *@
                <div class="px-4 py-2 rounded-3" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);">
                    <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.65rem; letter-spacing: 1px;">Sức nóng</small>
                    <span class="text-warning fw-bold fs-6"><i class="bi bi-fire me-1"></i> @Model.ViewCount lượt xem</span>
                </div>
            </div>

            <h6 class="text-uppercase fw-bold mt-4" style="color: #00ff87; letter-spacing: 1px;"><i class="bi bi-card-text me-2"></i>Nội dung tóm tắt</h6>
            <p class="text-light" style="line-height: 1.8; opacity: 0.85; text-align: justify; font-size: 0.95rem;">
                @(string.IsNullOrEmpty(Model.Description) ? "Đang cập nhật nội dung cho bộ phim này..." : Model.Description)
            </p>

            <div class="row mt-5 pt-4 border-top" style="border-color: rgba(255,255,255,0.05) !important;">
                <div class="col-auto mb-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn fw-bold px-4 py-2 rounded-pill ajax-link shadow" style="background: #fbbf24; color: #000; white-space: nowrap; display: inline-flex; align-items: center;">
                        <i class="bi bi-pencil-square me-2"></i> Chỉnh sửa phim
                    </a>
                </div>
                    <div class="col-auto mb-2">
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn fw-bold px-4 py-2 rounded-pill ajax-link" style="background: transparent; color: #ef4444; border: 2px solid #ef4444; white-space: nowrap; display: inline-flex; align-items: center; width: auto; height: auto;">
                            <i class="bi bi-trash me-2"></i> Xóa phim
                        </a>
                    </div>
            </div>
        </div>
    </div>
</div>