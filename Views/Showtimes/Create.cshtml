@model DoAnDatVeXemPhim.Models.Showtime

@{
    Layout = Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest" ? null : "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="dashboard-panel-card slide-in-bottom">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3" style="border-color: rgba(255,255,255,0.05) !important;">
        <div>
            <h4 class="fw-bold m-0 text-uppercase" style="color: #00ff87; letter-spacing: 0.5px; text-shadow: 0 0 10px rgba(0,255,135,0.2);">
                <i class="bi bi-calendar-plus-fill me-2"></i>THÊM SUẤT CHIẾU MỚI
            </h4>
            <p class="text-muted small m-0 mt-1">Hệ thống sẽ tự động tính thời gian kết thúc dựa trên thời lượng phim</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary text-light ajax-link rounded-pill px-4 fw-bold shadow-sm">
            <i class="bi bi-arrow-left me-1"></i> Quay lại lịch chiếu
        </a>
    </div>

    <form id="createShowtimeForm" asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row g-4">
            @* Cột 1: Thông tin Phim & Địa điểm *@
            <div class="col-md-6">
                <h6 class="fw-bold text-uppercase mb-4" style="color: #00ff87;"><i class="bi bi-1-circle me-1"></i> NỘI DUNG & ĐỊA ĐIỂM</h6>

                <div class="mb-4">
                    <label asp-for="MovieId" class="form-label fw-bold small text-muted">PHIM TRÌNH CHIẾU</label>
                    <select asp-for="MovieId" class="form-select form-control-neon" asp-items="ViewBag.MovieId">
                        <option value="">-- Chọn phim từ danh sách --</option>
                    </select>
                    <span asp-validation-for="MovieId" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="CinemaHallId" class="form-label fw-bold small text-muted">PHÒNG CHIẾU (CHI NHÁNH)</label>
                    <select asp-for="CinemaHallId" class="form-select form-control-neon" asp-items="ViewBag.CinemaHallId">
                        <option value="">-- Chọn phòng & rạp --</option>
                    </select>
                    <span asp-validation-for="CinemaHallId" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Format" class="form-label fw-bold small text-muted">ĐỊNH DẠNG CHIẾU</label>
                    <div class="d-flex gap-2">
                        @foreach (var format in new[] { "2D", "3D", "IMAX" })
                        {
                            <div class="flex-fill">
                                <input type="radio" class="btn-check" name="Format" id="format-@format" value="@format" @(format == "2D" ? "checked" : "")>
                                <label class="btn btn-outline-neon w-100 fw-bold py-2" for="format-@format">@format</label>
                            </div>
                        }
                    </div>
                    <span asp-validation-for="Format" class="text-danger small"></span>
                </div>
            </div>

            @* Cột 2: Thời gian & Giá vé *@
            <div class="col-md-6 border-start" style="border-color: rgba(255,255,255,0.05) !important; padding-left: 24px;">
                <h6 class="fw-bold text-uppercase mb-4" style="color: #60a5fa;"><i class="bi bi-2-circle me-1"></i> THỜI GIAN & GIÁ VÉ</h6>

                <div class="mb-4">
                    <label asp-for="StartTime" class="form-label fw-bold small text-muted">GIỜ BẮT ĐẦU</label>
                    <input asp-for="StartTime" class="form-control form-control-neon" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" />
                    <span asp-validation-for="StartTime" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="BasePrice" class="form-label fw-bold small text-muted">GIÁ VÉ GỐC (VNĐ)</label>
                    <div class="input-group">
                        <span class="input-group-text border-0 fw-bold" style="background: rgba(0,255,135,0.1); color: #00ff87;">₫</span>
                        <input asp-for="BasePrice" class="form-control form-control-neon" placeholder="Ví dụ: 75000" />
                    </div>
                    <span asp-validation-for="BasePrice" class="text-danger small"></span>
                </div>

                <div class="p-3 rounded-3" style="background: rgba(0,0,0,0.3); border: 1px dashed rgba(255,255,255,0.1);">
                    <div class="form-check form-switch p-0 d-flex align-items-center justify-content-between">
                        <label class="form-check-label fw-bold text-light mb-0" asp-for="IsActive" style="color: #e5e7eb !important;">Kích hoạt suất chiếu ngay</label>
                        <input class="form-check-input ms-0 mt-0 neon-switch" style="width: 2.5em; height: 1.25em;" type="checkbox" asp-for="IsActive" checked>
                    </div>
                    <small class="text-muted d-block mt-2">Suất chiếu sẽ hiển thị trên hệ thống cho khách hàng đặt vé.</small>
                </div>

                <input type="hidden" asp-for="EndTime" value="@DateTime.Now" />
            </div>
        </div>

        <div class="mt-4 pt-4 border-top text-end" style="border-color: rgba(255,255,255,0.05) !important;">
            <button type="submit" class="btn btn-save-neon px-5 py-2 fw-bold rounded-pill text-uppercase shadow-sm">
                <i class="bi bi-save-fill me-2"></i> LƯU LỊCH CHIẾU
            </button>
        </div>
    </form>
</div>

<style>
    .form-control-neon {
        background-color: rgba(0, 0, 0, 0.4) !important;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        color: #ffffff !important;
        color-scheme: dark;
        transition: all 0.3s ease;
    }

        .form-control-neon:focus {
            border-color: #00ff87 !important;
            box-shadow: 0 0 0 3px rgba(0, 255, 135, 0.2) !important;
            background-color: rgba(0, 0, 0, 0.6) !important;
        }

    select.form-control-neon option {
        background-color: #111827;
        color: #ffffff;
    }

    .btn-outline-neon {
        color: #9ca3af;
        border: 1px solid rgba(255, 255, 255, 0.1);
        background: rgba(255,255,255,0.05);
        transition: all 0.2s ease;
    }

    .btn-check:checked + .btn-outline-neon {
        background: rgba(0, 255, 135, 0.15) !important;
        color: #00ff87 !important;
        border-color: #00ff87 !important;
        box-shadow: 0 0 10px rgba(0,255,135,0.2);
    }

    .btn-save-neon {
        background-color: #00ff87;
        color: #022c22;
        border: none;
        transition: all 0.3s ease;
    }

        .btn-save-neon:hover {
            background-color: #00e676;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0, 255, 135, 0.4);
        }

    /* Switch Neon */
    .neon-switch:checked {
        background-color: #00ff87 !important;
        border-color: #00ff87 !important;
    }
</style>

<script>
    // AJAX CHO FORM CREATE SHOWTIMES
    $('#createShowtimeForm').on('submit', function(e) {
        e.preventDefault();
        var $form = $(this);
        var $contentBox = $('#admin-dynamic-content');
        var $loader = $('#admin-loader');

        $contentBox.css('opacity', '0.3');
        $loader.fadeIn(200);

        $.ajax({
            url: $form.attr('action'),
            type: $form.attr('method'),
            data: $form.serialize(),
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
            success: function (res) {
                $contentBox.html(res);
                $loader.fadeOut(200, function() {
                    $contentBox.css('opacity', '1');
                });
            },
            error: function () {
                alert('Có lỗi xảy ra khi lưu lịch chiếu!');
                $loader.fadeOut(200);
                $contentBox.css('opacity', '1');
            }
        });
    });
</script>
