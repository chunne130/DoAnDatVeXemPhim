@model DoAnDatVeXemPhim.Models.Showtime

@{
    Layout = Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest" ? null : "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="dashboard-panel-card slide-in-bottom">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3" style="border-color: rgba(255,255,255,0.05) !important;">
        <div>
            <h4 class="fw-bold m-0 text-uppercase" style="color: #00ff87; letter-spacing: 0.5px; text-shadow: 0 0 10px rgba(0,255,135,0.2);">
                <i class="bi bi-ticket-perforated-fill me-2"></i> CHI TIẾT SUẤT CHIẾU
            </h4>
            <p class="text-muted small m-0 mt-1">Thông tin chi tiết khung giờ chiếu mã số #@Model.Id</p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary text-light ajax-link rounded-pill px-4 fw-bold shadow-sm">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
    </div>

    <div class="row align-items-center mb-5 mt-2">
        <div class="col-md-3 text-center">
            <div style="border: 2px solid rgba(0,255,135,0.2); border-radius: 12px; padding: 4px; display: inline-block; background: rgba(255,255,255,0.02);">
                <img src="@Model.Movie?.PosterUrl" class="img-fluid rounded-3 shadow-lg" style="max-height: 280px; object-fit: cover;" />
            </div>
        </div>

        <div class="col-md-9 mt-4 mt-md-0">
            <h2 class="fw-black text-white mb-2" style="text-shadow: 0 2px 10px rgba(0,0,0,0.5); letter-spacing: 1px;">@Model.Movie?.Title</h2>

            <div class="mb-4">
                <span class="badge" style="background: @(Model.Format == "IMAX" ? "rgba(239, 68, 68, 0.15)" : "rgba(255,255,255,0.08)"); color: @(Model.Format == "IMAX" ? "#ef4444" : "#d1d5db"); border: 1px solid @(Model.Format == "IMAX" ? "rgba(239, 68, 68, 0.3)" : "rgba(255,255,255,0.2)"); font-size: 0.8rem; padding: 6px 12px; letter-spacing: 1px;">
                    <i class="bi bi-display me-1"></i> ĐỊNH DẠNG @Model.Format
                </span>
            </div>

            <div class="d-flex align-items-center gap-3">
                <div class="p-3 rounded-4 shadow-sm text-center" style="background: rgba(0,0,0,0.4); border: 1px solid rgba(255,255,255,0.05); min-width: 120px;">
                    <small class="d-block small fw-bold text-uppercase" style="color: #6b7280; letter-spacing: 1px;">GIỜ CHIẾU</small>
                    <span class="fw-bold fs-4" style="color: #00ff87; text-shadow: 0 0 10px rgba(0,255,135,0.3);">@Model.StartTime.ToString("HH:mm")</span>
                </div>
                <i class="bi bi-arrow-right fs-4" style="color: #4b5563;"></i>
                <div class="p-3 rounded-4 shadow-sm text-center" style="background: rgba(0,0,0,0.4); border: 1px solid rgba(255,255,255,0.05); min-width: 120px;">
                    <small class="d-block small fw-bold text-uppercase" style="color: #6b7280; letter-spacing: 1px;">KẾT THÚC</small>
                    <span class="fw-bold fs-4" style="color: #9ca3af;">@Model.EndTime.ToString("HH:mm")</span>
                </div>

                <div class="ms-3 p-3 rounded-4 text-center border-start" style="border-color: rgba(255,255,255,0.1) !important;">
                    <small class="d-block small fw-bold text-uppercase" style="color: #6b7280; letter-spacing: 1px;">NGÀY CHIẾU</small>
                    <span class="fw-bold fs-5 text-white">@Model.StartTime.ToString("dd/MM/yyyy")</span>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 border-top pt-4" style="border-color: rgba(255,255,255,0.05) !important;">
        <div class="col-sm-6">
            <div class="p-4 rounded-4 h-100" style="background: rgba(17, 24, 39, 0.4); border: 1px solid rgba(255,255,255,0.05);">
                <small class="fw-bold d-block mb-3 text-uppercase" style="color: #60a5fa; letter-spacing: 1px;"><i class="bi bi-geo-alt me-1"></i> Địa điểm chiếu</small>
                <p class="mb-1 fw-bold text-white fs-5"><i class="bi bi-door-open me-2" style="color: #fbbf24;"></i>@Model.CinemaHall?.Name</p>
                <p class="mb-0 text-muted"><i class="bi bi-building me-2"></i>@Model.CinemaHall?.Cinema?.Name</p>
            </div>
        </div>

        <div class="col-sm-6">
            <div class="p-4 rounded-4 h-100" style="background: rgba(17, 24, 39, 0.4); border: 1px solid rgba(255,255,255,0.05);">
                <small class="fw-bold d-block mb-3 text-uppercase" style="color: #fbbf24; letter-spacing: 1px;"><i class="bi bi-tags me-1"></i> Giá vé niêm yết</small>
                <p class="mb-0 fw-bold fs-3" style="color: #00ff87; text-shadow: 0 0 10px rgba(0,255,135,0.3);">
                    @Model.BasePrice.ToString("N0") <span style="font-size: 1rem; color: #9ca3af;">VNĐ</span>
                </p>
            </div>
        </div>

        <div class="col-12 mt-4">
            <div class="p-4 rounded-4 d-flex align-items-center" style="background: @(Model.IsActive ? "rgba(0,255,135,0.05)" : "rgba(255,255,255,0.02)"); border: 1px solid @(Model.IsActive ? "rgba(0,255,135,0.2)" : "rgba(255,255,255,0.05)");">
                <i class="bi @(Model.IsActive ? "bi-check-circle-fill text-success" : "bi-slash-circle-fill text-secondary") fs-3 me-3" style="color: @(Model.IsActive ? "#00ff87" : "#9ca3af") !important;"></i>
                <div>
                    <strong class="d-block mb-1 text-white" style="font-size: 1.1rem;">Trạng thái hệ thống:</strong>
                    <span style="color: @(Model.IsActive ? "#00ff87" : "#9ca3af");">@(Model.IsActive ? "Đang công chiếu và mở bán vé trên toàn hệ thống" : "Suất chiếu đang bị tạm ẩn, khách hàng không thể đặt vé")</span>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-3 mt-5 pt-4 border-top" style="border-color: rgba(255,255,255,0.05) !important;">
        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn fw-bold rounded-pill px-5 shadow-sm ajax-link text-dark" style="background: #fbbf24;">
            <i class="bi bi-pencil-square me-2"></i> CHỈNH SỬA
        </a>
    </div>
</div>
