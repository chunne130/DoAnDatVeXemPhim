    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/vanilla-tilt/1.8.0/vanilla-tilt.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        window.addEventListener('scroll', function () {
            const navbar = document.querySelector('.navbar');
            if (window.scrollY > 50) {
                navbar.classList.add('scrolled');
            } else {
                navbar.classList.remove('scrolled');
            }
        });

        var globalSearchDebounce;
        $('#globalSearchInput').on('input', function () {
            var keyword = $(this).val().trim();
            clearTimeout(globalSearchDebounce);

            if (keyword === '') {
                $('#globalSearchInitial').removeClass('d-none');
                $('#globalSearchLoading').addClass('d-none');
                $('#globalSearchData').addClass('d-none').html('');
                return;
            }

            $('#globalSearchInitial').addClass('d-none');
            $('#globalSearchData').addClass('d-none');
            $('#globalSearchLoading').removeClass('d-none');

            globalSearchDebounce = setTimeout(function () {
                $.ajax({
                    url: '@Url.Action("Index", "Home")',
                    type: 'GET',
                    data: { searchString: keyword },
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    success: function (html) {
                        $('#globalSearchLoading').addClass('d-none');
                        $('#globalSearchData').html(html).removeClass('d-none');
                    },
                    error: function () {
                        $('#globalSearchLoading').addClass('d-none');
                        $('#globalSearchData').html('<p class="text-danger text-center">Có lỗi xảy ra khi tìm kiếm.</p>').removeClass('d-none');
                    }
                });
            }, 300);
        });

        var searchOffcanvas = document.getElementById('globalSearchOffcanvas');
        if (searchOffcanvas) {
            searchOffcanvas.addEventListener('shown.bs.offcanvas', function () {
                document.getElementById('globalSearchInput').focus();
            });
        }
    </script>

    @if (TempData["ErrorMessage"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi',
                    text: @Html.Raw(Json.Serialize(TempData["ErrorMessage"])),
                    confirmButtonColor: '#ef4444',
                    background: '#0d1f10',
                    color: '#fff',
                    customClass: {
                        popup: 'border border-danger'
                    }
                });
            });
        </script>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                Swal.fire({
                    icon: 'success',
                    title: 'Thành công',
                    text: @Html.Raw(Json.Serialize(TempData["SuccessMessage"])),
                    confirmButtonColor: '#00ff87',
                    background: '#0d1f10',
                    color: '#fff',
                    customClass: {
                        popup: 'border border-success'
                    }
                });
            });
        </script>
    }

    @if (TempData["WarningMessage"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                Swal.fire({
                    icon: 'warning',
                    iconColor: '#00ff87',
                    title: 'Thông báo',
                    text: @Html.Raw(Json.Serialize(TempData["WarningMessage"])),
                    confirmButtonColor: '#00ff87',
                    confirmButtonText: 'Đã hiểu',
                    background: '#0d1f10',
                    color: '#fff',
                    customClass: {
                        popup: 'border border-success'
                    }
                });
            });
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
