@using DoAnDatVeXemPhim.Models
@model CinemaHall

@{
    Layout = Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest" ? null : "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="p-4 p-md-5">
    @* Header thông tin *@
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3" style="border-color: rgba(255,255,255,0.05) !important;">
        <div>
            <h4 class="fw-bold m-0 text-uppercase" style="color: #22d3ee; text-shadow: 0 0 10px rgba(34,211,238,0.3);">
                <i class="bi bi-door-open-fill me-2"></i>THÔNG TIN CHI TIẾT
            </h4>
            <small class="text-muted">Cấu hình kỹ thuật hiện tại của phòng chiếu</small>
        </div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    @* Khối hiển thị trung tâm *@
    <div class="text-center my-4 py-2">
        <div class="d-inline-block p-4 rounded-circle mb-3 shadow" style="background: rgba(34, 211, 238, 0.1); border: 1px solid rgba(34, 211, 238, 0.2);">
            <i class="bi bi-display text-info display-4" style="color: #22d3ee !important;"></i>
        </div>
        <h2 class="fw-bold text-white text-uppercase m-0" style="letter-spacing: 0.5px;">@Model.Name</h2>
        <span class="badge rounded-pill px-3 py-2 mt-2 fw-bold" style="background-color: rgba(251, 191, 36, 0.1); color: #fbbf24; border: 1px solid rgba(251,191,36,0.15);">
            <i class="bi bi-star-fill me-1"></i> PHÒNG CHIẾU TIÊU CHUẨN
        </span>
    </div>

    @* Lưới thông số phòng *@
    <div class="row g-3 mt-2">
        @* Cụm Rạp quản lý *@
        <div class="col-12">
            <div class="p-3 rounded-3" style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05);">
                <small class="text-muted d-block text-uppercase fw-bold mb-2" style="font-size: 0.7rem; letter-spacing: 0.5px;">Thuộc Cụm Rạp quản lý</small>
                <p class="fs-5 mb-1 fw-bold text-white">
                    <i class="bi bi-building text-danger me-2" style="color: #ef4444 !important;"></i>@Model.Cinema?.Name
                </p>
                <small class="text-muted d-block ms-4"><i class="bi bi-geo-alt me-1"></i>@Model.Cinema?.Address, @Model.Cinema?.City</small>
            </div>
        </div>

        @* Khối sức chứa ghế *@
        <div class="col-sm-6">
            <div class="p-3 rounded-3 h-100" style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05);">
                <small class="text-muted d-block text-uppercase fw-bold mb-1" style="font-size: 0.7rem;">Tổng sức chứa</small>
                <p class="fs-4 mb-0 fw-bold" style="color: #00ff87;">
                    <i class="bi bi-people-fill me-2"></i>@Model.TotalSeats Ghế
                </p>
            </div>
        </div>

        @* Khối mã hệ thống phòng *@
        <div class="col-sm-6">
            <div class="p-3 rounded-3 h-100" style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05);">
                <small class="text-muted d-block text-uppercase fw-bold mb-1" style="font-size: 0.7rem;">Mã Số Định Danh</small>
                <p class="fs-4 mb-0 fw-bold text-white-50 font-monospace">#ROOM-@Model.Id</p>
            </div>
        </div>
    </div>

    @* Thanh điều hướng dưới chân Modal *@
    <div class="d-flex justify-content-end gap-3 mt-5 pt-4 border-top" style="border-color: rgba(255,255,255,0.05) !important;">
        <button type="button" class="btn btn-outline-light rounded-pill px-4 fw-bold" data-bs-dismiss="modal" style="border-color: rgba(255,255,255,0.15);">
            ĐỒNG Ý & ĐÓNG
        </button>
    </div>
</div>
