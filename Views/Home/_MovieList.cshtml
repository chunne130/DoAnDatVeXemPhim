@model IEnumerable<DoAnDatVeXemPhim.Models.Movie>

@if (Model != null && Model.Any())
{
    var ticketsDict = ViewBag.TicketsSold as Dictionary<int, int>;
    foreach (var item in Model)
    {
        int sold = ticketsDict != null && ticketsDict.ContainsKey(item.Id) ? ticketsDict[item.Id] : 0;
        <movie-card id="@item.Id"
                    title="@item.Title"
                    poster-url="@item.PosterUrl"
                    duration="@item.Duration"
                    genre-name="@(item.Genres != null ? string.Join(", ", item.Genres.Select(g => g.Name)) : "")"
                    is-hot="true"
                    view-count="@sold"
                    average-rating="@(item.MovieReviews?.Any() == true ? item.MovieReviews.Average(r => r.Rating) : 0)">
        </movie-card>
    }
}
else
{
    <div class="text-center py-5 w-100">
        <h4 class="text-muted fw-bold"> Tiếc quá bạn ơi!</h4>
        <p class="text-secondary">Cinema Hub không tìm thấy bộ phim nào khớp với bộ lọc chi tiết rồi ạ.</p>
        <a href="@Url.Action("Index", "Home")" class="btn btn-danger rounded-pill px-4 mt-2 shadow-sm">Xem tất cả phim</a>
    </div>
}