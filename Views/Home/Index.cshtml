                                            @if (avgRating > 0) { <span class="mc-star"><i class="bi bi-star-fill me-1"></i>@avgRating.ToString("F1")</span> } else { <span style="color:#6b7280">—</span> }
                                        </div>
                                        <span><i class="bi bi-clock me-1"></i>@item.Duration phút</span>
                                    </div>
                                    @{
                                        var ticketsDictMain = ViewBag.TicketsSold as Dictionary<int, int>;
                                        int soldMain = ticketsDictMain != null && ticketsDictMain.ContainsKey(item.Id) ? ticketsDictMain[item.Id] : 0;
                                        int pct = Math.Min(soldMain, 100);
                                    }
                                    <div class="mc-ticket-wrap">
