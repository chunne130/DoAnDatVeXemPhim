@using DoAnDatVeXemPhim.Models
@model IEnumerable<Movie>

@{
    ViewData["Title"] = "Trang chủ - Cinema Hub";
}

@*  Hàm Helper tự động giải thích và bọc badge tuổi *@
@functions {
    public Microsoft.AspNetCore.Html.IHtmlContent RenderAgeBadge(string age)
    {
        if (string.IsNullOrEmpty(age)) return Microsoft.AspNetCore.Html.HtmlString.Empty;

        string bgStyle = age switch
        {
            "P" => "background-color: #00ff87; color: #022c22; box-shadow: 0 0 12px rgba(0, 255, 135, 0.6); text-shadow: 0 0 2px rgba(0, 255, 135, 0.3);",
            "K" => "background-color: #0dcaf0; color: #000000; box-shadow: 0 0 12px rgba(13, 202, 240, 0.6);",
            "T13" => "background-color: #fbbf24; color: #1a0f00; box-shadow: 0 0 12px rgba(251, 191, 36, 0.6);",
            "T16" => "background-color: #f97316; color: #ffffff; box-shadow: 0 0 12px rgba(249, 115, 22, 0.6);",
            "T18" => "background-color: #ef4444; color: #ffffff; box-shadow: 0 0 12px rgba(239, 68, 68, 0.7); text-shadow: 0 0 3px rgba(239, 68, 68, 0.5);",
            _ => "background-color: #6b7280; color: #ffffff;"
        };

        string text = age switch
        {
            "P" => "P - Mọi độ tuổi",
            "K" => "K - Dưới 13",
            "T13" => "T13 - Từ 13+",
            "T16" => "T16 - Từ 16+",
            "T18" => "T18 - Từ 18+",
            _ => "Chưa rõ"
        };

        return new Microsoft.AspNetCore.Html.HtmlString($"<span class=\"age-tag-custom\" style=\"{bgStyle}\">{text}</span>");
    }
}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    *, *::before, *::after {
        box-sizing: border-box;
    }

    body {
        font-family: 'Inter', sans-serif;
        background-image: radial-gradient(ellipse at 0% 100%, rgba(0,160,70,0.55) 0%, rgba(0,80,30,0.3) 30%, transparent 55%), radial-gradient(ellipse at 100% 0%, rgba(0,160,70,0.45) 0%, rgba(0,80,30,0.25) 28%, transparent 50%);
        background-color: #010a04;
        background-attachment: fixed;
        background-size: cover;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        color: #ffffff;
    }

    /* ── BANNER ── */

    .cinema-banner {
        position: relative;
        height: 380px;
        overflow: hidden;
    }

        .cinema-banner .banner-bg-img {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            filter: brightness(0.28);
            display: block;
            animation: kenburns 20s ease-out infinite alternate;
        }

    .banner-gradient-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to right, rgba(1,10,4,0.92) 0%, rgba(1,10,4,0.5) 55%, transparent 100%);
    }

    .banner-content {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 0 48px;
        max-width: 560px;
    }

    .banner-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(0,255,135,0.1);
        border: 1px solid rgba(0,255,135,0.25);
        color: #00ff87;
        font-size: 0.62rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        padding: 4px 10px;
        border-radius: 4px;
        margin-bottom: 14px;
        width: fit-content;
    }

    .banner-badge-dot {
        width: 6px;
        height: 6px;
        background: #00ff87;
        border-radius: 50%;
        display: inline-block;
    }

    .banner-title {
        font-size: 2.1rem;
        font-weight: 800;
        color: #fff;
        line-height: 1.15;
        margin-bottom: 10px;
        text-transform: uppercase;
        letter-spacing: -0.5px;
    }

    .banner-desc {
        font-size: 0.83rem;
        color: rgba(255,255,255,0.52);
        line-height: 1.65;
        margin-bottom: 22px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .banner-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        background: #00ff87;
        color: #022c22;
        font-size: 0.82rem;
        font-weight: 700;
        padding: 11px 22px;
        border-radius: 6px;
        border: none;
        cursor: pointer;
        text-decoration: none;
        width: fit-content;
        transition: all 0.2s ease;
    }

        .banner-btn:hover {
            background: #00e676;
            color: #022c22;
            transform: translateY(-2px);
            box-shadow: 0 0 20px rgba(0, 255, 135, 0.6);
        }

    .banner-carousel-dots {
        position: absolute;
        bottom: 18px;
        left: 48px;
        display: flex;
        gap: 6px;
    }

    .banner-dot {
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: rgba(255,255,255,0.2);
        transition: all 0.3s;
    }

        .banner-dot.active {
            width: 20px;
            background: #00ff87;
        }

    .carousel-control-prev, .carousel-control-next {
        width: 42px;
        height: 42px;
        background: rgba(0,0,0,0.45);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 50%;
        top: 50%;
        transform: translateY(-50%);
        opacity: 0;
        transition: opacity 0.25s;
    }

    .cinema-banner:hover .carousel-control-prev,
    .cinema-banner:hover .carousel-control-next {
        opacity: 1;
    }

    .carousel-control-prev {
        left: 16px;
    }

    .carousel-control-next {
        right: 16px;
    }

    /* ── SEARCH BAR ── */
    .search-section {
        position: relative;
        z-index: 30;
        padding: 20px 0 8px;
    }

    .search-bar-wrap {
        background: rgba(10,22,13,0.7);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 12px;
        padding: 12px 16px;
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .sf-field {
        display: flex;
        align-items: center;
        gap: 8px;
        background: #0d1f10;
        border: 1px solid #1a3320;
        border-radius: 8px;
        padding: 0 12px;
        height: 40px;
        flex: 1;
        min-width: 120px;
        transition: border-color 0.2s;
    }

        .sf-field:focus-within {
            border-color: #00ff87;
            box-shadow: 0 0 0 3px rgba(0,255,135,0.12);
        }

        .sf-field i {
            font-size: 0.85rem;
            color: #3d7a52;
            flex-shrink: 0;
        }

    /* ── SKELETON LOADING BONE ── */
    
    .poster-container {
        position: relative;
        border-radius: 12px;
        overflow: hidden;
        background: linear-gradient(90deg, #111827 25%, #1f2937 50%, #111827 75%);
        background-size: 200% 100%;
        animation: shimmer 2s infinite linear;
    }

    .poster-container img {
        position: relative;
        z-index: 1;
        opacity: 0;
        transition: opacity 0.5s ease;
    }
    .poster-container img.loaded {
        opacity: 1;
    }

        .sf-field input, .sf-field select {
            background: transparent;
            border: none;
            outline: none;
            color: #fff;
            font-size: 0.83rem;
            font-family: 'Inter', sans-serif;
            width: 100%;
            font-weight: 500;
        }

            .sf-field input::placeholder {
                color: #3d6650;
            }

            .sf-field select option {
                background: #0d1f10;
                color: #fff;
            }

    .sf-divider {
        width: 1px;
        height: 22px;
        background: rgba(255,255,255,0.06);
        flex-shrink: 0;
    }

    .btn-find {
        height: 40px;
        background: #00ff87;
        border: none;
        border-radius: 8px;
        color: #022c22;
        font-size: 0.82rem;
        font-weight: 700;
        padding: 0 20px;
        display: flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
        flex-shrink: 0;
        transition: all 0.18s;
    }

        .btn-find:hover {
            background: #00e676;
            transform: translateY(-1px);
            box-shadow: 0 5px 16px rgba(0,255,135,0.35);
        }

    .btn-reset {
        height: 40px;
        background: #0d1f10;
        border: 1px solid #1a3320;
        border-radius: 8px;
        color: #5a8a6a;
        font-size: 0.82rem;
        font-weight: 600;
        padding: 0 14px;
        cursor: pointer;
        flex-shrink: 0;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 5px;
    }

        .btn-reset:hover {
            background: #1a3320;
            color: #fff;
        }

    /* ── SECTION CHUNG ── */
    .section-block {
        background: transparent;
        padding: 0;
        margin-bottom: 48px;
    }

    .section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 22px;
        padding-bottom: 13px;
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }

    .section-title {
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .section-title h2 {
            font-size: 1.45rem;
            font-weight: 700;
            color: #fff;
            margin: 0;
        }

    .accent-bar {
        width: 4px;
        height: 20px;
        background: #00ff87;
        border-radius: 2px;
        flex-shrink: 0;
    }

    .accent-bar-yellow {
        width: 4px;
        height: 20px;
        background: #fbbf24;
        border-radius: 2px;
        flex-shrink: 0;
    }
</style>

@* ─── BANNER CHÍNH (DÀNH CHO PHIM) ─── *@
<div id="movieCarousel" class="carousel slide carousel-fade cinema-banner mb-0" data-bs-ride="carousel">
    <div class="carousel-inner" style="height:100%;">
        @for (int i = 0; i < Model.Take(3).Count(); i++)
        {
            var movie = Model.ElementAt(i);
            <div class="carousel-item @(i == 0 ? "active" : "")" style="height:100%;">
                <img src="@movie.PosterUrl" class="banner-bg-img" alt="@movie.Title">
                <div class="banner-gradient-overlay"></div>
                <div class="banner-content">
                    <span class="banner-badge">
                        <span class="banner-badge-dot"></span> Đang chiếu
                    </span>
                    <h1 class="banner-title">@movie.Title</h1>
                    <p class="banner-desc">@movie.Description</p>
                    <a asp-action="SelectShowtime" asp-controller="Booking" asp-route-movieId="@movie.Id" class="banner-btn">
                        <i class="bi bi-ticket-perforated"></i> Đặt vé ngay
                    </a>
                </div>
                <div class="banner-carousel-dots">
                    @for (int d = 0; d < Model.Take(3).Count(); d++)
                    {
                        <div class="banner-dot @(d == i ? "active" : "")"></div>
                    }
                </div>
            </div>
        }
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#movieCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#movieCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
    </button>
</div>

@* ─── GỢI Ý PHIM THEO GU ─── *@
@if (ViewBag.RecommendedMovies != null && ((List<Movie>)ViewBag.RecommendedMovies).Count > 0)
{
    <div class="container-xl mt-5">
        <div class="section-block mb-3">
            <div class="recommend-banner">
                <i class="bi bi-stars"></i>
                <span><strong>Dành riêng cho bạn</strong> — Gợi ý dựa theo thể loại bạn xem nhiều nhất</span>
            </div>
            <div class="section-header">
                <div class="section-title">
                    <div class="accent-bar-yellow"></div>
                    <h2 style="color:#fbbf24;">Có thể bạn sẽ thích</h2>
                </div>
            </div>
            <div class="row row-cols-2 row-cols-md-4 g-4">
                @foreach (var item in (List<Movie>)ViewBag.RecommendedMovies)
                {
                    <div class="col">
                        <div class="mc-wrap" data-tilt data-tilt-max="5" data-tilt-speed="400" data-tilt-glare="true" data-tilt-max-glare="0.2">
                            <div class="mc-poster-wrap" id="mc-rec-@item.Id">
                                <img src="@item.PosterUrl" alt="@item.Title"
                                     loading="lazy"
                                     onload="this.classList.add('mc-loaded'); document.getElementById('mc-rec-@item.Id').classList.add('img-loaded')"
                                     onerror="this.src='/img/placeholder.jpg'; this.classList.add('mc-loaded')" />
                                
                                @if (!string.IsNullOrEmpty(item.AgeRestriction))
                                {
                                    <div class="badge-age-cyber-floating">@RenderAgeBadge(item.AgeRestriction)</div>
                                }

                                @{ bool isFavRec = ViewBag.FavoriteMovieIds != null && ((List<int>)ViewBag.FavoriteMovieIds).Contains(item.Id); }
                                <button class="btn-favorite-heart @(isFavRec ? "active" : "")" data-movie-id="@item.Id">
                                    <i class="bi @(isFavRec ? "bi-heart-fill" : "bi-heart")"></i>
                                </button>
                                
                                <div class="mc-overlay">
                                    <span class="badge mb-1" style="background:rgba(251,191,36,0.15);color:#fbbf24;border:1px solid rgba(251,191,36,0.3);font-size:0.6rem;">
                                        <i class="bi bi-stars me-1"></i>GỢI Ý
                                    </span>
                                    <a href="@Url.Action("SelectShowtime", "Booking", new { movieId = item.Id })" class="mc-btn-p">
                                        <i class="bi bi-ticket-perforated me-2"></i>Đặt vé ngay
                                    </a>
                                    <a href="@Url.Action("MovieDetails", "Home", new { id = item.Id })" class="mc-btn-o">
                                        <i class="bi bi-info-circle me-2"></i>Xem chi tiết
                                    </a>
                                </div>
                            </div>
                            <div class="mc-body">
                                <a href="@Url.Action("MovieDetails", "Home", new { id = item.Id })" class="text-decoration-none">
                                    <h6 class="mc-title">@item.Title</h6>
                                </a>
                                <div class="mc-genres">
                                    @if (item.Genres != null && item.Genres.Any()) {
                                        foreach (var g in item.Genres.Take(2)) { <span class="mc-genre-tag">@g.Name</span> }
                                    }
                                </div>
                                <div class="mc-meta">
                                    <div>
                                        @{ double avgRatingRec = item.MovieReviews?.Any() == true ? item.MovieReviews.Average(r => r.Rating) : 0; }
                                        @if (avgRatingRec > 0) { <span class="mc-star"><i class="bi bi-star-fill me-1"></i>@avgRatingRec.ToString("F1")</span> } else { <span style="color:#6b7280">—</span> }
                                    </div>
                                    <span><i class="bi bi-clock me-1"></i>@item.Duration phút</span>
                                </div>
                                @{
                                    var ticketsDictRec = ViewBag.TicketsSold as Dictionary<int, int>;
                                    int soldRec = ticketsDictRec != null && ticketsDictRec.ContainsKey(item.Id) ? ticketsDictRec[item.Id] : 0;
                                    int pctRec = Math.Min(soldRec, 100);
                                }
                                <div class="mc-ticket-wrap">
                                    <div class="mc-ticket-lbl"><i class="bi bi-ticket-perforated me-1"></i>@soldRec vé đã bán</div>
                                    <div class="mc-ticket-bar"><div class="mc-ticket-fill" style="width:@(pctRec)%"></div></div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@* ─── SEARCH BAR ─── *@
<div class="container-xl search-section d-none d-md-block" id="searchSection">
    <div class="search-bar-wrap">
        <form id="realtimeSearchForm" method="get" autocomplete="off"
              style="display:flex;align-items:center;gap:8px;flex:1;flex-wrap:wrap;">
            <div class="sf-field" style="flex:2;min-width:160px;">
                <i class="bi bi-search"></i>
                <input type="text" id="ajaxSearchString" placeholder="Tìm tên phim..." value="@ViewBag.CurrentSearch">
            </div>
            <div class="sf-divider d-none d-md-block"></div>
            <div class="sf-field" style="min-width:120px;">
                <i class="bi bi-tags"></i>
                <select id="ajaxGenreId">
                    <option value="">Thể loại</option>
                    @if (ViewBag.Genres != null)
                    {
                        foreach (var g in ViewBag.Genres)
                        {
                            <option value="@g.Id">@g.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="sf-divider d-none d-md-block"></div>
            <div class="sf-field" style="min-width:100px;">
                <i class="bi bi-badge-hd"></i>
                <select id="ajaxFormat">
                    <option value="">Định dạng</option>
                    <option value="2D">2D</option>
                    <option value="3D">3D</option>
                    <option value="IMAX">IMAX</option>
                </select>
            </div>
            <div class="sf-divider d-none d-md-block"></div>
            <div class="sf-field" style="min-width:130px;">
                <i class="bi bi-calendar3"></i>
                <input type="text" id="ajaxShowDate" placeholder="Chọn ngày xem..." style="color-scheme:dark; background: transparent; border: none; color: #fff; width: 120px; outline: none; cursor: pointer;">
            </div>
            <button type="submit" class="btn-find">
                <i class="bi bi-search"></i> Tìm phim
            </button>
            <button type="button" id="btnResetFilters" class="btn-reset">
                <i class="bi bi-x-circle"></i> Xóa lọc
            </button>
        </form>
    </div>

    @* --- ĐÃ THÊM: Tính năng Behavior Tracking (Trending Searches) --- *@
    @if (ViewBag.TrendingSearches != null && ((List<string>)ViewBag.TrendingSearches).Count > 0)
    {
        <div class="trending-searches mt-2 d-flex align-items-center flex-wrap gap-2" style="padding: 0 12px; font-size: 0.85rem; color: #a1a1aa;">
            <span><i class="bi bi-fire text-warning"></i> Xu hướng:</span>
            @foreach (var keyword in (List<string>)ViewBag.TrendingSearches)
            {
                <span class="badge rounded-pill bg-dark border border-secondary trending-keyword" 
                      style="cursor:pointer; transition: all 0.2s;" 
                      onclick="document.getElementById('ajaxSearchString').value='@keyword'; document.getElementById('realtimeSearchForm').dispatchEvent(new Event('submit'));">
                    @keyword
                </span>
            }
        </div>
    }
</div>

@* ─── CẤU TRÚC LƯỚI CHÍNH (MAIN + SIDEBAR) ─── *@
<div class="container-xl mt-4 pb-5">
    <div class="row gx-4">
        
        @* CỘT TRÁI (DANH SÁCH PHIM CHÍNH) *@
        <div class="col-lg-9">
            @* ─── NOW SHOWING ─── *@
