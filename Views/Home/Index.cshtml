                                        <div class="mc-ticket-bar"><div class="mc-ticket-fill" style="width:@(pct)%"></div></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* CỘT PHẢI (THỊNH HÀNH) *@
        <div class="col-lg-3">
            @if (ViewBag.TrendingMovies != null && ((List<Movie>)ViewBag.TrendingMovies).Count > 0)
            {
                var trendingMovies = (List<Movie>)ViewBag.TrendingMovies;
                
                <div class="sticky-top" style="top: 100px;">
                    <div class="d-flex align-items-center mb-3">
                        <h5 class="mb-0 text-uppercase fw-900" style="letter-spacing: 0.5px;">
                            <i class="bi bi-fire text-warning me-2"></i> Xu hướng: <span class="text-white">Thịnh Hành</span>
                        </h5>
                    </div>
                    
                    <div class="p-3 rounded-4 d-flex flex-column shadow-lg" style="background: rgba(10,22,13,0.5); border: 1px solid rgba(255,255,255,0.05);">
                        <div class="d-flex flex-column gap-3">
                            @{ int rank = 1; }
                            @foreach (var m in trendingMovies)
                            {
                                <a href="@Url.Action("MovieDetails", "Home", new { id = m.Id })" class="text-decoration-none text-white trending-list-item">
                                    <div class="d-flex gap-3 align-items-center p-2 rounded-3 transition-all" style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.02);">
                                        <div class="position-relative">
                                            <img src="@m.PosterUrl" class="rounded-2" style="width: 60px; height: 85px; object-fit: cover;" alt="@m.Title">
                                        </div>
                                        <div class="d-flex flex-column flex-grow-1 overflow-hidden">
                                            <h6 class="fw-bold mb-1 text-truncate" style="font-size: 0.9rem;">@m.Title</h6>
                                            <div class="d-flex align-items-center justify-content-between mt-1" style="font-size: 0.8rem; color: #9ca3af;">
                                                <span class="fw-bold fs-6" style="color: @(rank == 1 ? "#fbbf24" : (rank == 2 ? "#d1d5db" : (rank == 3 ? "#b45309" : "#00ff87")));">#@rank</span>
                                                <span><i class="bi bi-fire text-danger me-1"></i>@m.ViewCount</span>
                                            </div>
                                        </div>
                                    </div>
                                </a>
                                rank++;
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
        
    </div>
</div>

@* ─── FLOATING CHATBOX ─── *@
