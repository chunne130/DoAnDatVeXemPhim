@{
    ViewData["Title"] = "Điều khoản chung";
}

<div class="container py-5" style="margin-top: 80px; max-width: 900px;">
    <div class="p-4 p-md-5 rounded-5" style="background: rgba(13, 31, 16, 0.7); backdrop-filter: blur(15px); border: 1px solid rgba(255,255,255,0.05); color: #e2e8f0; line-height: 1.8; box-shadow: 0 10px 30px rgba(0,0,0,0.5);">
        <h2 class="fw-bold mb-3" style="color: #00ff87; letter-spacing: 1px;"><i class="bi bi-file-text-fill me-2"></i> @ViewData["Title"]</h2>
        <hr style="border-color: rgba(0, 255, 135, 0.2);" />
        
        <div class="content-section mt-4" style="font-size: 1.05rem;">
            <h5 class="fw-bold text-white mt-4">1. Quy định về tài khoản</h5>
            <p>Người dùng phải cung cấp thông tin chính xác khi đăng ký tài khoản. Bạn có trách nhiệm bảo mật thông tin đăng nhập của mình và mọi hoạt động diễn ra dưới tài khoản đó.</p>

            <h5 class="fw-bold text-white mt-4">2. Đặt vé và Thanh toán</h5>
            <p>Việc đặt vé chỉ thành công khi hệ thống báo xác nhận và thanh toán hoàn tất. Vui lòng kiểm tra lại thông tin vé, rạp, và suất chiếu trước khi thanh toán.</p>

            <h5 class="fw-bold text-white mt-4">3. Quy định tại rạp chiếu</h5>
            <p>Khách hàng cần tuân thủ quy định độ tuổi của phim. Ban quản lý rạp có quyền từ chối phục vụ nếu khách hàng vi phạm nội quy, gây rối hoặc mang theo đồ ăn thức uống từ bên ngoài.</p>
            
            <div class="alert mt-5 border-0" style="background: rgba(0, 255, 135, 0.1); color: #00ff87; border-radius: 12px;">
                <i class="bi bi-info-circle me-2"></i> CINEMA HUB có quyền thay đổi các điều khoản này vào bất kỳ lúc nào mà không cần thông báo trước.
            </div>
        </div>
    </div>
</div>
