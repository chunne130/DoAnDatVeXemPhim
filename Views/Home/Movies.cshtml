@model IEnumerable<DoAnDatVeXemPhim.Models.Movie>
@{
    ViewData["Title"] = "Phim Đang Chiếu - Cinema Hub";
    var ticketsSold = ViewBag.TicketsSold as Dictionary<int, int> ?? new Dictionary<int, int>();
    var allGenres = Model?.SelectMany(m => m.Genres ?? new List<DoAnDatVeXemPhim.Models.Genre>())
                          .GroupBy(g => g.Id).Select(g => g.First()).ToList()
                    ?? new List<DoAnDatVeXemPhim.Models.Genre>();
}

<style>
    /* ─── PAGE HERO ─── */
    .movies-hero {
        position: relative;
        padding: 80px 0 50px;
        overflow: hidden;
        background: radial-gradient(ellipse at 60% 0%, rgba(0,255,135,0.08) 0%, transparent 70%),
                    radial-gradient(ellipse at 0% 80%, rgba(0,200,100,0.05) 0%, transparent 60%);
    }
    .movies-hero::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%2300ff87' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
        pointer-events: none;
    }
    .hero-title-gradient {
        background: linear-gradient(135deg, #fff 40%, #00ff87 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        font-size: clamp(2rem, 5vw, 3.5rem);
        font-weight: 900;
        letter-spacing: -1px;
        line-height: 1.1;
    }
    .hero-stat-card {
        background: rgba(0,255,135,0.06);
        border: 1px solid rgba(0,255,135,0.15);
        border-radius: 16px;
        padding: 20px 28px;
        text-align: center;
        transition: all 0.3s ease;
    }
    .hero-stat-card:hover {
        background: rgba(0,255,135,0.12);
        transform: translateY(-3px);
        box-shadow: 0 10px 30px rgba(0,255,135,0.1);
    }
    .hero-stat-num {
        font-size: 2.2rem;
        font-weight: 900;
        color: #00ff87;
        line-height: 1;
    }
    .hero-stat-label {
        font-size: 0.8rem;
        color: #6b7280;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-top: 4px;
    }

    /* ─── FILTER PILLS ─── */
    .filter-bar {
        background: rgba(10,20,13,0.8);
        backdrop-filter: blur(15px);
        border-bottom: 1px solid rgba(255,255,255,0.05);
        padding: 16px 0;
        position: sticky;
        top: 70px;
        z-index: 20;
    }
    .filter-pill {
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.1);
        color: #9ca3af;
        border-radius: 50px;
        padding: 6px 18px;
        font-size: 0.85rem;
        cursor: pointer;
        transition: all 0.25s;
        white-space: nowrap;
        user-select: none;
    }
    .filter-pill:hover, .filter-pill.active {
        background: rgba(0,255,135,0.15);
        border-color: #00ff87;
        color: #00ff87;
        box-shadow: 0 0 12px rgba(0,255,135,0.15);
    }
    /* Custom sort dropdown */
    .custom-sort-wrapper {
        position: relative;
        user-select: none;
    }
    .custom-sort-trigger {
        display: flex;
        align-items: center;
        gap: 10px;
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.12);
        color: #fff;
        border-radius: 50px;
        padding: 7px 18px;
        font-size: 0.85rem;
        cursor: pointer;
        transition: all 0.25s;
        white-space: nowrap;
        min-width: 140px;
    }
    .custom-sort-trigger:hover,
    .custom-sort-trigger.open {
        border-color: #00ff87;
        background: rgba(0,255,135,0.08);
        color: #00ff87;
        box-shadow: 0 0 12px rgba(0,255,135,0.12);
    }
    .custom-sort-trigger .trigger-icon {
        margin-left: auto;
        transition: transform 0.3s ease;
        opacity: 0.6;
    }
    .custom-sort-trigger.open .trigger-icon { transform: rotate(180deg); color: #00ff87; opacity: 1; }

    .custom-sort-menu {
        position: absolute;
        top: calc(100% + 8px);
        right: 0;
        min-width: 180px;
        background: rgba(10, 25, 14, 0.97);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(0,255,135,0.15);
        border-radius: 16px;
        padding: 8px;
        box-shadow: 0 20px 50px rgba(0,0,0,0.7), 0 0 0 1px rgba(0,255,135,0.05);
        z-index: 100;
        display: none;
        transform-origin: top right;
        animation: sortDropIn 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .custom-sort-menu.open { display: block; }
    @@keyframes sortDropIn {
        0% { opacity: 0; transform: scale(0.8) translateY(-10px); }
        100% { opacity: 1; transform: scale(1) translateY(0); }
    }
    .sort-option {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 14px;
        border-radius: 10px;
        color: #9ca3af;
        font-size: 0.88rem;
        cursor: pointer;
        transition: all 0.2s;
    }
    .sort-option:hover { background: rgba(0,255,135,0.1); color: #00ff87; }
    .sort-option.selected { background: rgba(0,255,135,0.08); color: #00ff87; font-weight: 600; }
    .sort-option .sort-icon { width: 22px; text-align: center; font-size: 1rem; }

    /* ─── MOVIE CARDS ─── */
    .movie-grid { padding: 36px 0 60px; }

    .movie-card-wrap {
        position: relative;
        border-radius: 18px;
        overflow: hidden;
        background: rgba(255,255,255,0.02);
        border: 1px solid rgba(255,255,255,0.06);
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        cursor: pointer;
        display: flex;
        flex-direction: column;
        height: 100%;
    }
    .movie-card-wrap:hover {
        transform: translateY(-10px) scale(1.01);
        border-color: rgba(0,255,135,0.35);
        box-shadow: 0 25px 50px rgba(0,0,0,0.5), 0 0 0 1px rgba(0,255,135,0.1), 0 0 30px rgba(0,255,135,0.08);
    }

    /* Poster area */
    .poster-wrap {
        position: relative;
        padding-top: 150%;
        overflow: hidden;
    }
    .poster-wrap img {
        position: absolute;
        top: 0; left: 0;
        width: 100%; height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
        opacity: 0;
    }
    .poster-wrap img.loaded { opacity: 1; }
    .movie-card-wrap:hover .poster-wrap img { transform: scale(1.08); }

    /* Skeleton shimmer */
    .poster-wrap::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(90deg, #0d1f10 25%, #1a3320 50%, #0d1f10 75%);
        background-size: 200% 100%;
        animation: shimmer 2s infinite;
    }
    .poster-wrap.img-loaded::before { display: none; }

    @@keyframes shimmer {
        0% { background-position: 200% 0; }
        100% { background-position: -200% 0; }
    }

    /* Gradient overlay on hover */
    .poster-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(0,0,0,0.95) 0%, rgba(0,0,0,0.4) 55%, transparent 100%);
        opacity: 0;
        transition: opacity 0.35s ease;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-end;
        padding: 20px 16px;
        gap: 10px;
    }
    .movie-card-wrap:hover .poster-overlay { opacity: 1; }

    .overlay-btn-primary {
        background: #00ff87;
        color: #022c22;
        border: none;
        border-radius: 50px;
        padding: 10px 0;
        font-weight: 700;
        font-size: 0.88rem;
        width: 100%;
        cursor: pointer;
        transition: all 0.2s;
        text-decoration: none;
        display: block;
        text-align: center;
        transform: translateY(10px);
        opacity: 0;
        transition: all 0.3s ease 0.05s;
    }
    .overlay-btn-outline {
        background: rgba(255,255,255,0.1);
        color: #fff;
        border: 1px solid rgba(255,255,255,0.3);
        border-radius: 50px;
        padding: 8px 0;
        font-weight: 600;
        font-size: 0.83rem;
        width: 100%;
        cursor: pointer;
        transition: all 0.2s;
        text-decoration: none;
        display: block;
        text-align: center;
        transform: translateY(10px);
        opacity: 0;
        transition: all 0.3s ease 0s;
    }
    .movie-card-wrap:hover .overlay-btn-primary,
    .movie-card-wrap:hover .overlay-btn-outline {
        opacity: 1;
        transform: translateY(0);
    }
    .overlay-btn-primary:hover { background: #00e676; color: #022c22; }
    .overlay-btn-outline:hover { background: rgba(255,255,255,0.2); color: #fff; border-color: rgba(255,255,255,0.6); }

    /* Badges */
    .age-badge {
        position: absolute;
        top: 12px; left: 12px;
        padding: 3px 10px;
        border-radius: 6px;
        font-weight: 700;
        font-size: 0.72rem;
        letter-spacing: 0.5px;
        z-index: 2;
    }
    .badge-t13 { background: #f59e0b; color: #000; }
    .badge-t16 { background: #ef4444; color: #fff; }
    .badge-t18 { background: #7c3aed; color: #fff; }
    .badge-p { background: #10b981; color: #000; }

    .hot-badge {
        position: absolute;
        top: 12px; right: 12px;
        background: linear-gradient(135deg, #ff416c, #ff4b2b);
        color: #fff;
        padding: 3px 10px;
        border-radius: 6px;
        font-weight: 700;
        font-size: 0.7rem;
        letter-spacing: 0.5px;
        z-index: 2;
        animation: pulseHot 2s infinite;
    }
    @@keyframes pulseHot {
        0%, 100% { box-shadow: 0 0 6px rgba(255,65,108,0.5); }
        50% { box-shadow: 0 0 18px rgba(255,65,108,0.9); }
    }

    /* Card body */
    .movie-card-body {
        padding: 18px 16px 20px;
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 10px;
        background: linear-gradient(180deg, rgba(10,22,13,0) 0%, rgba(10,22,13,1) 30%);
    }
    .movie-card-title {
        font-size: 1rem;
        font-weight: 700;
        color: #fff;
        margin: 0;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        transition: color 0.2s;
    }
    .movie-card-wrap:hover .movie-card-title { color: #00ff87; }

    .genre-tags { display: flex; flex-wrap: wrap; gap: 5px; }
    .genre-tag {
        font-size: 0.72rem;
        padding: 2px 9px;
        border-radius: 50px;
        background: rgba(0,255,135,0.07);
        color: #4ade80;
        border: 1px solid rgba(0,255,135,0.15);
    }

    .movie-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 0.78rem;
        color: #6b7280;
        margin-top: auto;
    }
    .movie-meta .rating {
        display: flex;
        align-items: center;
        gap: 4px;
        color: #f59e0b;
        font-weight: 700;
    }

    /* Ticket counter */
    .ticket-bar-wrap { margin-top: 2px; }
    .ticket-label { font-size: 0.72rem; color: #6b7280; margin-bottom: 4px; display: flex; justify-content: space-between; }
    .ticket-bar { height: 3px; background: rgba(255,255,255,0.08); border-radius: 3px; overflow: hidden; }
    .ticket-bar-fill {
        height: 100%;
        background: linear-gradient(90deg, #00ff87, #00e676);
        border-radius: 3px;
        transition: width 1s ease;
    }

    /* Empty state */
    .empty-state { padding: 80px 0; text-align: center; }
    .empty-icon { font-size: 5rem; color: rgba(255,255,255,0.08); margin-bottom: 24px; }

    /* View toggle */
    .view-toggle-btn {
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.1);
        color: #6b7280;
        border-radius: 8px;
        padding: 6px 12px;
        cursor: pointer;
        transition: all 0.2s;
    }
    .view-toggle-btn.active, .view-toggle-btn:hover {
        background: rgba(0,255,135,0.1);
        border-color: rgba(0,255,135,0.3);
        color: #00ff87;
    }

    /* List view */
    .list-view .movie-col { flex: 0 0 100%; max-width: 100%; }
    .list-view .movie-card-wrap { flex-direction: row; max-height: 180px; }
    .list-view .poster-wrap { padding-top: 0; width: 120px; min-width: 120px; height: 180px; }
    .list-view .poster-wrap img { position: relative; width: 100%; height: 100%; object-fit: cover; }
    .list-view .movie-card-body { padding: 20px; }
    .list-view .poster-overlay { display: none; }
</style>

@* ─── HERO ─── *@
<section class="movies-hero">
    <div class="container-xl">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span style="width:5px; height:5px; border-radius:50%; background:#00ff87; box-shadow:0 0 8px #00ff87;"></span>
                    <span style="font-size:0.8rem; color:#00ff87; letter-spacing:2px; text-transform:uppercase; font-weight:600;">Đang Chiếu</span>
                </div>
                <h1 class="hero-title-gradient mb-3">Phim Đang<br>Chiếu Tại Rạp</h1>
                <p style="color:#6b7280; font-size:1.05rem; max-width:500px; line-height:1.7;">
                    Khám phá các tựa phim đang được chiếu tại hệ thống rạp Cinema Hub trên toàn quốc. Đặt vé ngay hôm nay!
                </p>
            </div>
            <div class="col-lg-5">
                <div class="row g-3">
                    <div class="col-6">
                        <div class="hero-stat-card">
                            <div class="hero-stat-num">@(Model?.Count() ?? 0)</div>
                            <div class="hero-stat-label">Phim đang chiếu</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="hero-stat-card">
                            <div class="hero-stat-num">@allGenres.Count</div>
                            <div class="hero-stat-label">Thể loại</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="hero-stat-card">
                            <div class="hero-stat-num">@(ticketsSold.Values.Sum())</div>
                            <div class="hero-stat-label">Vé đã bán</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="hero-stat-card">
                            @{
                                var avgRating = Model?.Where(m => m.MovieReviews?.Any() == true)
                                                     .Select(m => m.MovieReviews.Average(r => r.Rating))
                                                     .DefaultIfEmpty(0).Average() ?? 0;
                            }
                            <div class="hero-stat-num">@avgRating.ToString("F1")<span style="font-size:1rem;">★</span></div>
                            <div class="hero-stat-label">Điểm TB</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@* ─── FILTER BAR ─── *@
<div class="filter-bar">
    <div class="container-xl">
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <div class="d-flex align-items-center gap-2 flex-wrap flex-grow-1" id="genrePills">
                <span class="filter-pill active" data-genre="all" onclick="filterGenre(this, 'all')">
                    <i class="bi bi-grid-3x3-gap me-1"></i> Tất cả
                </span>
                @foreach (var g in allGenres)
                {
                    <span class="filter-pill" data-genre="@g.Name" onclick="filterGenre(this, '@g.Name')">@g.Name</span>
                }
            </div>
            <div class="d-flex align-items-center gap-2 ms-auto flex-shrink-0">
                <!-- Custom Sort Dropdown -->
                <div class="custom-sort-wrapper" id="sortWrapper">
                    <div class="custom-sort-trigger" id="sortTrigger" onclick="toggleSortMenu()">
                        <i class="bi bi-sliders me-1"></i>
                        <span id="sortLabel">Mặc định</span>
                        <i class="bi bi-chevron-down trigger-icon"></i>
                    </div>
                    <div class="custom-sort-menu" id="sortMenu">
                        <div class="sort-option selected" data-value="default" onclick="selectSort(this, 'default', 'Mặc định')">
                            <span class="sort-icon">✦</span> Mặc định
                        </div>
                        <div class="sort-option" data-value="rating" onclick="selectSort(this, 'rating', 'Đánh giá cao')">
                            <span class="sort-icon"></span> Đánh giá cao
                        </div>
                        <div class="sort-option" data-value="tickets" onclick="selectSort(this, 'tickets', 'Bán chạy')">
                            <span class="sort-icon"></span> Bán chạy
                        </div>
                        <div class="sort-option" data-value="newest" onclick="selectSort(this, 'newest', 'Mới nhất')">
                            <span class="sort-icon"></span> Mới nhất
                        </div>
                    </div>
                </div>
                <button class="view-toggle-btn active" id="btnGrid" onclick="setView('grid')" title="Dạng lưới">
                    <i class="bi bi-grid-3x3-gap"></i>
                </button>
                <button class="view-toggle-btn" id="btnList" onclick="setView('list')" title="Dạng danh sách">
                    <i class="bi bi-list-ul"></i>
                </button>
            </div>
        </div>
    </div>
</div>

@* ─── GRID ─── *@
<div class="movie-grid">
    <div class="container-xl">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <p class="mb-0" style="color:#6b7280; font-size:0.9rem;" id="resultsCount">
                Hiển thị <strong class="text-white" id="countNum">@(Model?.Count() ?? 0)</strong> phim
            </p>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="row g-4" id="movieGrid">
                @foreach (var movie in Model)
                {
                    var sold = ticketsSold.ContainsKey(movie.Id) ? ticketsSold[movie.Id] : 0;
                    var avgRev = movie.MovieReviews?.Any() == true ? movie.MovieReviews.Average(r => r.Rating) : 0;
                    var isHot = sold > 20;
                    var genreNames = movie.Genres != null ? string.Join(",", movie.Genres.Select(g => g.Name)) : "";
                    var genreDisplay = movie.Genres != null ? string.Join(", ", movie.Genres.Select(g => g.Name)) : "";
                    var maxSold = ticketsSold.Values.Any() ? ticketsSold.Values.Max() : 1;
                    var barPct = maxSold > 0 ? Math.Min((double)sold / maxSold * 100, 100) : 0;

                    <div class="col-6 col-md-4 col-lg-3 movie-col" data-genre="@genreNames" data-rating="@avgRev" data-tickets="@sold" data-date="@(movie.ReleaseDate?.ToString("yyyyMMdd") ?? "0")">
                        <div class="movie-card-wrap h-100">
                            <div class="poster-wrap" id="pw-@movie.Id">
                                <img src="@movie.PosterUrl" alt="@movie.Title"
                                     loading="lazy"
                                     onload="this.classList.add('loaded'); document.getElementById('pw-@movie.Id').classList.add('img-loaded')"
                                     onerror="this.src='/img/placeholder.jpg'; this.classList.add('loaded');" />

                                @* Age badge *@
                                @if (!string.IsNullOrEmpty(movie.AgeRestriction))
                                {
                                    var ageClass = movie.AgeRestriction.Contains("13") ? "badge-t13" :
                                                   movie.AgeRestriction.Contains("16") ? "badge-t16" :
                                                   movie.AgeRestriction.Contains("18") ? "badge-t18" : "badge-p";
                                    <span class="age-badge @ageClass">@movie.AgeRestriction</span>
                                }

                                @if (isHot)
                                {
                                    <span class="hot-badge"> HOT</span>
                                }

                                <div class="poster-overlay">
                                    <a href="/Home/MovieDetails/@movie.Id" class="overlay-btn-primary">
                                        <i class="bi bi-ticket-perforated me-2"></i>Đặt vé ngay
                                    </a>
                                    <a href="/Home/MovieDetails/@movie.Id" class="overlay-btn-outline">
                                        <i class="bi bi-info-circle me-2"></i>Xem chi tiết
                                    </a>
                                </div>
                            </div>

                            <div class="movie-card-body">
                                <a href="/Home/MovieDetails/@movie.Id" class="text-decoration-none">
                                    <h6 class="movie-card-title">@movie.Title</h6>
                                </a>

                                @if (movie.Genres?.Any() == true)
                                {
                                    <div class="genre-tags">
                                        @foreach (var g in movie.Genres.Take(2))
                                        {
                                            <span class="genre-tag">@g.Name</span>
                                        }
                                    </div>
                                }

                                <div class="movie-meta">
                                    <div class="rating">
                                        <i class="bi bi-star-fill"></i>
                                        <span>@(avgRev > 0 ? avgRev.ToString("F1") : "—")</span>
                                        @if (movie.MovieReviews?.Any() == true)
                                        {
                                            <span style="color:#6b7280; font-weight:400;">(@movie.MovieReviews.Count)</span>
                                        }
                                    </div>
                                    <span><i class="bi bi-clock me-1"></i>@movie.Duration phút</span>
                                </div>

                                @if (sold > 0)
                                {
                                    <div class="ticket-bar-wrap">
                                        <div class="ticket-label">
                                            <span><i class="bi bi-ticket-perforated me-1"></i>@sold vé đã bán</span>
                                        </div>
                                        <div class="ticket-bar">
                                            <div class="ticket-bar-fill" style="width: @barPct.ToString("F0")%"></div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon"><i class="bi bi-film"></i></div>
                <h4 class="text-white mb-2">Hiện không có phim nào đang chiếu</h4>
                <p style="color:#6b7280;">Vui lòng quay lại sau hoặc khám phá phim sắp chiếu!</p>
                <a asp-controller="Home" asp-action="Upcoming" class="btn mt-3" style="background:#00ff87; color:#022c22; font-weight:700; border-radius:50px; padding: 12px 32px;">
                    <i class="bi bi-calendar-event me-2"></i>Xem phim sắp chiếu
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
    let currentGenre = 'all';
    let currentView = 'grid';

    // ─── CUSTOM SORT DROPDOWN ───
    function toggleSortMenu() {
        const trigger = document.getElementById('sortTrigger');
        const menu = document.getElementById('sortMenu');
        trigger.classList.toggle('open');
        menu.classList.toggle('open');
    }
    function selectSort(el, value, label) {
        document.querySelectorAll('.sort-option').forEach(o => o.classList.remove('selected'));
        el.classList.add('selected');
        document.getElementById('sortLabel').textContent = label;
        document.getElementById('sortTrigger').classList.remove('open');
        document.getElementById('sortMenu').classList.remove('open');
        sortMovies(value);
    }
    // Click outside to close
    document.addEventListener('click', e => {
        const wrapper = document.getElementById('sortWrapper');
        if (wrapper && !wrapper.contains(e.target)) {
            document.getElementById('sortTrigger').classList.remove('open');
            document.getElementById('sortMenu').classList.remove('open');
        }
    });

    function filterGenre(el, genre) {
        // Update pills
        document.querySelectorAll('.filter-pill').forEach(p => p.classList.remove('active'));
        el.classList.add('active');
        currentGenre = genre;
        applyFilters();
    }

    function sortMovies(sortBy) {
        const grid = document.getElementById('movieGrid');
        const cols = [...grid.querySelectorAll('.movie-col')];

        cols.sort((a, b) => {
            if (sortBy === 'rating') {
                return parseFloat(b.dataset.rating) - parseFloat(a.dataset.rating);
            } else if (sortBy === 'tickets') {
                return parseInt(b.dataset.tickets) - parseInt(a.dataset.tickets);
            } else if (sortBy === 'newest') {
                return (b.dataset.date || '0').localeCompare(a.dataset.date || '0');
            }
            return 0;
        });

        grid.innerHTML = '';
        cols.forEach(c => grid.appendChild(c));
        applyFilters();
    }

    function applyFilters() {
        const cols = document.querySelectorAll('.movie-col');
        let visible = 0;

        cols.forEach(col => {
            const genres = col.dataset.genre || '';
            const show = currentGenre === 'all' || genres.split(',').some(g => g.trim() === currentGenre);
            col.style.display = show ? '' : 'none';
            if (show) visible++;
        });

        document.getElementById('countNum').textContent = visible;
    }

    function setView(view) {
        currentView = view;
        const grid = document.getElementById('movieGrid');
        const btnGrid = document.getElementById('btnGrid');
        const btnList = document.getElementById('btnList');

        if (view === 'list') {
            grid.classList.add('list-view');
            btnList.classList.add('active');
            btnGrid.classList.remove('active');
        } else {
            grid.classList.remove('list-view');
            btnGrid.classList.add('active');
            btnList.classList.remove('active');
        }
    }

    // Staggered animation khi load
    document.addEventListener('DOMContentLoaded', () => {
        const cards = document.querySelectorAll('.movie-col');
        cards.forEach((card, i) => {
            card.style.opacity = '0';
            card.style.transform = 'translateY(30px)';
            setTimeout(() => {
                card.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
                card.style.opacity = '1';
                card.style.transform = 'translateY(0)';
            }, i * 60);
        });
    });
</script>
}
