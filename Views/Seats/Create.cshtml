@model DoAnDatVeXemPhim.Models.Seat

@{
    ViewData["Title"] = "Thêm ghế lẻ";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-dark text-warning py-3 text-center rounded-top-4">
                    <h5 class="mb-0 fw-bold text-uppercase"><i class="bi bi-plus-circle-fill me-2"></i>Thêm ghế mới</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        @* Nếu bấm từ Index qua thì CinemaHallId đã có sẵn *@
                        <div class="mb-3">
                            <label asp-for="CinemaHallId" class="form-label fw-bold small">PHÒNG CHIẾU</label>
                            <select asp-for="CinemaHallId" class="form-select border-2 shadow-sm bg-light" asp-items="ViewBag.CinemaHallId"></select>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SeatNumber" class="form-label fw-bold small">SỐ GHẾ (VÍ DỤ: A10)</label>
                            <input asp-for="SeatNumber" class="form-control border-2 shadow-sm" />
                            <span asp-validation-for="SeatNumber" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="SeatType" class="form-label fw-bold small">LOẠI GHẾ</label>
                            <select asp-for="SeatType" class="form-select border-2 shadow-sm">
                                <option value="Normal">Ghế Thường</option>
                                <option value="VIP">Ghế VIP</option>
                                <option value="Sweetbox">Ghế Đôi (Sweetbox)</option>
                            </select>
                            <span asp-validation-for="SeatType" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-warning fw-bold py-2 shadow-sm">TẠO GHẾ</button>
                            <a href="javascript:history.back()" class="btn btn-link text-muted small text-decoration-none">Hủy bỏ</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>