@model DoAnDatVeXemPhim.Models.Seat

@{
    ViewData["Title"] = "Xác nhận xóa ghế";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden border-top border-danger border-5">
                <div class="card-body p-5 text-center">
                    @* Icon cảnh báo lớn *@
                    <div class="text-danger mb-4">
                        <i class="bi bi-exclamation-octagon-fill display-1"></i>
                    </div>

                    <h3 class="fw-bold text-dark mb-2 text-uppercase">XÓA GHẾ NÀY?</h3>
                    <p class="text-muted small mb-4">Hành động này không thể hoàn tác. Ghế sẽ bị loại bỏ khỏi sơ đồ phòng chiếu.</p>

                    @* Box thông tin ghế *@
                    <div class="bg-light text-start p-4 rounded-3 mb-4 border">
                        <div class="d-flex justify-content-between border-bottom pb-2 mb-2">
                            <span class="text-muted fw-bold small">THÔNG TIN CHI TIẾT</span>
                            <span class="badge bg-dark text-warning">ID: #@Model.Id</span>
                        </div>
                        <div class="row g-2">
                            <div class="col-5 text-muted small">Số ghế:</div>
                            <div class="col-7 fw-bold">@Model.SeatNumber</div>

                            <div class="col-5 text-muted small">Loại ghế:</div>
                            <div class="col-7">
                                <span class="badge @(Model.SeatType == "VIP" ? "bg-warning text-dark" : (Model.SeatType == "Sweetbox" ? "bg-danger" : "bg-secondary"))">
                                    @Model.SeatType
                                </span>
                            </div>

                            <div class="col-5 text-muted small">Phòng chiếu:</div>
                            <div class="col-7 fw-bold text-primary">@Model.CinemaHall?.Name</div>
                        </div>
                    </div>

                    @* Form xác nhận *@
                    <form asp-action="Delete">
                        @* Cực kỳ quan trọng để Controller biết xóa cái nào *@
                        <input type="hidden" asp-for="Id" />

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-danger btn-lg fw-bold rounded-pill shadow">
                                <i class="bi bi-trash3-fill me-2"></i>XÁC NHẬN XÓA NGAY
                            </button>
                            <a asp-action="Index" asp-route-hallId="@Model.CinemaHallId" class="btn btn-link text-decoration-none text-muted mt-2">
                                <i class="bi bi-arrow-left me-1"></i> Hủy bỏ, quay về sơ đồ
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    body {
        background-color: #f8f9fa;
    }

    .card {
        transition: transform 0.3s ease;
    }

    .btn-danger {
        transition: all 0.3s ease;
    }

        .btn-danger:hover {
            transform: scale(1.02);
            box-shadow: 0 5px 15px rgba(220, 53, 69, 0.4) !important;
        }
</style>