@model dynamic
@{
    ViewData["Title"] = "Thanh toán QR - Cinema Hub";
}

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<div class="container mt-5 mb-5 text-center pb-5 slide-in-bottom">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            @* --- CYBERPUNK CARD --- *@
            <div class="card style-dark-card p-4 p-md-5 rounded-4 shadow-lg position-relative overflow-hidden">
                @* Hiệu ứng viền sáng góc trên *@
                <div class="position-absolute top-0 start-0 w-100" style="height: 4px; background: linear-gradient(90deg, transparent, #00ff87, transparent);"></div>

                <div class="mb-4">
                    <h3 class="fw-bold mb-2 text-uppercase" style="color: #00ff87; text-shadow: 0 0 15px rgba(0,255,135,0.4); letter-spacing: 1px;">
                        <i class="bi bi-qr-code-scan me-2"></i>Thanh toán vé
                    </h3>
                    <p class="text-muted small mb-0">Mở App Ngân hàng hoặc Ví điện tử để quét mã VietQR</p>
                </div>

                @* Vùng chứa mã QR (Nền trắng để quét dễ, viền Cyber) *@
                <div class="qr-cyber-box mx-auto mb-4 p-3 rounded-4 bg-white d-inline-block">
                    <img src="@ViewBag.QRUrl" class="img-fluid rounded-3" style="max-width: 240px;" alt="VietQR Payment">
                </div>

                @* Chi tiết chuyển khoản *@
                <div class="order-details p-3 rounded-3 text-start mb-4">
                    <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-2" style="border-color: rgba(255,255,255,0.1) !important;">
                        <span class="text-muted small text-uppercase fw-bold">Tổng thanh toán:</span>
                        <span class="fw-bold fs-4" style="color: #fbbf24; text-shadow: 0 0 10px rgba(251,191,36,0.3);">
                            @decimal.Parse(ViewBag.Total.ToString()).ToString("N0")<small class="ms-1 fs-6">đ</small>
                        </span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <span class="text-muted small text-uppercase fw-bold">Nội dung CK:</span>
                        <div class="d-flex align-items-center bg-dark px-3 py-1 rounded-pill border border-secondary border-opacity-50">
                            <span class="fw-bold text-white me-2" id="orderCode" style="letter-spacing: 1px;">@ViewBag.OrderCode</span>
                            <button class="btn btn-sm text-info py-0 px-1 btn-copy" onclick="copyCode()" title="Sao chép">
                                <i class="bi bi-copy"></i>
                            </button>
                        </div>
                    </div>
                </div>

                @* Khu vực nút hành động *@
                <div class="d-grid gap-3 mt-2">
                    @* Form ẩn submit dữ liệu *@
                    <form id="confirmPaidForm" asp-action="ConfirmPaid" method="POST" style="display:none;">
                        <input type="hidden" name="orderId" value="@ViewBag.OrderId" />
                    </form>

                    <button class="btn btn-cyber-success btn-lg rounded-pill fw-bold shadow-sm py-3 text-uppercase" id="btnPaidConfirm">
                        <i class="bi bi-check-circle-fill me-2"></i> TÔI ĐÃ CHUYỂN KHOẢN XONG
                    </button>

                    <a href="/" class="text-decoration-none small back-home-link mt-2">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại trang chủ
                    </a>
                </div>

                @* Thông báo an toàn *@
                <div class="mt-4 p-2 rounded-3" style="background: rgba(13, 202, 240, 0.1); border: 1px dashed rgba(13, 202, 240, 0.3);">
                    <p class="small mb-0" style="color: #60a5fa;">
                        <i class="bi bi-shield-check me-1"></i> Giao dịch được mã hóa an toàn. Vé sẽ được gửi qua Mail ngay sau khi Admin xác nhận!
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    body {
        background-color: #010a04; /* Tông đen rạp chiếu */
        font-family: 'Inter', sans-serif;
    }

    /* Giao diện Dark Card / Glassmorphism */
    .style-dark-card {
        background-color: rgba(17, 24, 39, 0.8) !important;
        border: 1px solid rgba(0, 255, 135, 0.2) !important;
        backdrop-filter: blur(12px);
    }

    /* QR Box Glow Effect */
    .qr-cyber-box {
        box-shadow: 0 0 25px rgba(0, 255, 135, 0.2);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border: 2px solid rgba(0, 255, 135, 0.5);
    }

        .qr-cyber-box:hover {
            transform: scale(1.03) translateY(-5px);
            box-shadow: 0 10px 35px rgba(0, 255, 135, 0.4);
        }

    /* Khung chứa chi tiết đơn hàng */
    .order-details {
        background: rgba(0, 0, 0, 0.4);
        border: 1px solid rgba(255, 255, 255, 0.05);
    }

    /* Nút sao chép */
    .btn-copy {
        transition: all 0.2s;
    }

        .btn-copy:hover {
            color: #00ff87 !important;
            transform: scale(1.1);
        }

    /* Nút Thanh Toán Cyberpunk */
    .btn-cyber-success {
        background: #00ff87 !important;
        color: #022c22 !important;
        border: none;
        transition: all 0.3s ease;
        letter-spacing: 0.5px;
    }

        .btn-cyber-success:hover {
            background: #00e676 !important;
            box-shadow: 0 5px 20px rgba(0, 255, 135, 0.5);
            transform: translateY(-2px);
        }

    /* Link quay về */
    .back-home-link {
        color: #9ca3af;
        transition: color 0.2s;
    }

        .back-home-link:hover {
            color: #fbbf24;
        }

    /* Animation Load Trang */
    .slide-in-bottom {
        animation: slideIn 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
    }
    @@keyframes slideIn {
        0%

    {
        transform: translateY(30px);
        opacity: 0;
    }

    100% {
        transform: translateY(0);
        opacity: 1;
    }

    }

    /* Fix font chữ cho SweetAlert */
    .swal2-title, .swal2-html-container {
        font-family: 'Inter', sans-serif !important;
    }
</style>

@section Scripts {
    <script>
        function copyCode() {
            var code = document.getElementById("orderCode").innerText;
            navigator.clipboard.writeText(code);
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'success',
                title: 'Đã sao chép mã nội dung!',
                showConfirmButton: false,
                timer: 2000,
                timerProgressBar: true,
                background: '#111827',
                color: '#00ff87',
                iconColor: '#00ff87'
            });
        }

        document.getElementById('btnPaidConfirm').addEventListener('click', function() {
            Swal.fire({
                title: 'Gửi yêu cầu xác thực?',
                text: "Bạn chắc chắn đã chuyển khoản đúng số tiền và nội dung chứ?",
                icon: 'question',
                showCancelButton: true,
                background: '#111827',
                color: '#ffffff',
                confirmButtonColor: '#00ff87',
                cancelButtonColor: '#4b5563',
                confirmButtonText: '<span style="color:#022c22; font-weight:bold;">Đúng, tôi đã chuyển!</span>',
                cancelButtonText: 'Chưa, để kiểm tra lại'
            }).then((result) => {
                if (result.isConfirmed) {
                    // Hiển thị hiệu ứng chờ ngầu lòi
                    Swal.fire({
                        title: 'Đang gửi yêu cầu...',
                        html: '<span style="color:#9ca3af;">Vui lòng không đóng trình duyệt lúc này</span>',
                        background: '#111827',
                        color: '#00ff87',
                        allowOutsideClick: false,
                        didOpen: () => {
                            Swal.showLoading();
                        }
                    });

                    // Submit form ẩn về Controller
                    document.getElementById('confirmPaidForm').submit();
                }
            });
        });
    </script>
}